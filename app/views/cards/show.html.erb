<% content_for :body_class, "detail-page" %>
<% content_for :title, "#{@card.name} · Shuffl" %>
<% content_for :meta_description, "#{@card.name} from #{@card.issuer}: #{@card.reward_summary}, #{card_annual_fee(@card)} annual fee. #{@card.description}" %>

<main>
  <p class="eyebrow"><%= [@card.issuer, @card.network.presence, @card.card_type.humanize].compact.join(" · ") %></p>
  <h1><%= @card.name %></h1>
  <p class="lede"><%= @card.real_catalogue? ? @card.value_profile[:title] : @card.description %></p>

  <div class="detail-layout">
    <div class="detail-aside">
      <div class="detail-art <%= card_finish(@card) %> <%= "has-card-image" if @card.image_path %>">
        <%= image_tag @card.image_path, alt: "", class: "card-image", decoding: "async" if @card.image_path %>
        <span class="brand"><%= render "shared/wordmark", link: false %></span>
        <span class="chip"></span>
        <span class="masked"><%= @card.name %></span>
      </div>

      <% if @quiz_rank %>
        <section class="detail-foryou" aria-label="How this card ranks for you">
          <p class="eyebrow">Based on your quiz</p>
          <p class="detail-foryou-rank">#<%= @quiz_rank %><span class="of">of <%= @quiz_total %> cards, for your answers</span></p>
          <% if @in_recommended_stack %>
            <p class="detail-foryou-note">This card is in your recommended stack.</p>
          <% elsif @quiz_rank <= 10 %>
            <p class="detail-foryou-note">A close fit, just outside your top <%= [ @quiz_total, 5 ].min %>.</p>
          <% else %>
            <p class="detail-foryou-note">Other cards fit your answers better. Worth comparing before you commit.</p>
          <% end %>
          <%= link_to "See your full results", quiz_response_path(latest_quiz_response), class: "detail-back detail-back--tight" %>
        </section>
      <% else %>
        <section class="detail-foryou detail-foryou--empty" aria-label="Find out if this card fits you">
          <p class="eyebrow">Is this the right card for you?</p>
          <p class="detail-foryou-copy"><%= Card::QUIZ_LENGTH_RANGE.max %> quick questions rank all <%= @card_total %> cards against how you actually spend.</p>
          <%= link_to "Take the quiz", new_quiz_response_path, class: "btn-wallet" %>
        </section>
      <% end %>
    </div>

    <div>
      <p class="detail-figure"><%= @card.real_catalogue? ? @card.value_profile[:value] : @card.headline_reward %></p>
      <p class="detail-figure-label"><%= @card.real_catalogue? ? @card.value_profile[:label] : @card.reward_summary %></p>

      <ul class="detail-facts">
        <li><span class="key">Annual fee</span><span class="value"><%= card_annual_fee(@card) %></span></li>
        <% if @card.displayed_welcome_offer.present? %><li><span class="key">Welcome offer</span><span class="value"><%= @card.displayed_welcome_offer %></span></li><% end %>
        <% if @card.credit_score_min.present? %><li><span class="key">Minimum credit score</span><span class="value"><%= @card.credit_score_min %></span></li><% end %>
        <li><span class="key">Foreign transaction fee</span><span class="value"><%= card_foreign_fee(@card) %></span></li>
      </ul>

      <% if @card.catalogue_status == "retired" %>
        <p>This is a retired demo card, kept for your saved history.</p>
      <% end %>
      <% if @card.real_catalogue? %>
        <section class="detail-section">
          <h2><%= @card.reward_rules.any? ? "How the rewards work" : "How this card works" %></h2>
          <% if @card.reward_rules.empty? %><p><%= @card.value_profile[:detail] %></p><% end %>
          <ul class="detail-perks">
            <% @card.reward_rules.each do |rule| %>
              <li><strong><%= rule["rate"] %> <%= rule["unit"].tr("_", " ") %> · <%= rule["category"] %></strong><br><%= rule["conditions"] %></li>
            <% end %>
          </ul>
          <% if @card.catalogue_terms.dig("fees", "intro").present? %><p>First-year fee terms: <%= @card.catalogue_terms.dig("fees", "intro") %></p><% end %>
          <% if @card.catalogue_terms["eligibility"].present? %><p><%= @card.catalogue_terms["eligibility"] %></p><% end %>
          <p>Check current application terms with the issuer. Approval and any personalised offer depend on the issuer’s checks.</p>
          <% Array(@card.catalogue_terms["recommendation_conditions"]).each do |condition| %><p><%= condition %></p><% end %>
          <ul>
            <% Array(@card.catalogue_terms["sources"]).each do |source| %>
              <li><%= link_to source["label"].presence || "Issuer source", source["url"], target: "_blank", rel: "noopener noreferrer" %> · checked <%= source["checked_on"] %></li>
            <% end %>
          </ul>
        </section>
      <% end %>
      <% perks = @card.perk_list %>
      <% if perks.any? %>
        <div class="detail-section">
          <h2>Perks</h2>
          <ul class="detail-perks">
            <% perks.each do |perk| %>
              <li><%= perk %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% categories = @card.best_for.to_s.split(",").map(&:strip).reject(&:blank?) %>
      <% if categories.any? %>
        <div class="detail-section">
          <h2>Best for</h2>
          <ul class="detail-tags">
            <% categories.each do |category| %>
              <li><%= link_to category, cards_path(category: category), "aria-label": "Browse #{category} cards" %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="detail-actions">
        <% if @card.catalogue_status == "retired" %>
          <span class="owned">This card is no longer available to add.</span>
        <% elsif !user_signed_in? %>
          <%= link_to "Sign in to save this card", new_user_session_path, class: "btn-wallet" %>
          <span class="owned">Saving keeps it in My Wallet. No application is made.</span>
        <% elsif current_user.cards.exists?(@card.id) %>
          <span class="owned">Already in My Wallet.</span>
          <%= link_to "Open My Wallet", wallet_items_path, class: "detail-back detail-back--tight" %>
        <% else %>
          <%= button_to "Add to Wallet", wallet_items_path(card_id: @card.id), method: :post, class: "btn-wallet" %>
        <% end %>
        <button type="button" class="detail-back detail-back--tight detail-ask" data-assistant-ask="From the catalogue, what does the <%= @card.name %> offer, and who suits it?">Ask <%= CardAssistant::NAME %> about this card</button>
      </div>
    </div>
  </div>

  <% if @stacks.any? || @similar_cards.any? %>
    <div class="detail-related">
      <% if @stacks.any? %>
        <section class="detail-section" aria-label="Stacks that include this card">
          <h2>In these stacks</h2>
          <ul class="detail-stacks">
            <% @stacks.each do |stack| %>
              <li>
                <%= link_to stack_path(stack) do %>
                  <span class="eyebrow"><%= stack.category %></span>
                  <span class="name"><%= stack.name %></span>
                  <span class="count"><%= pluralize(stack.cards.size, "card") %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <% if @similar_cards.any? %>
        <section class="detail-section" aria-label="Similar cards">
          <h2>Similar cards</h2>
          <ul class="mini-cards">
            <% @similar_cards.each do |card| %>
              <li>
                <%= link_to card_path(card) do %>
                  <div class="detail-art <%= card_finish(card) %> <%= "has-card-image" if card.image_path %>">
                    <%= image_tag card.image_path, alt: "", class: "card-image", decoding: "async" if card.image_path %>
                    <span class="brand"><%= render "shared/wordmark", link: false %></span>
                    <span class="chip"></span>
                  </div>
                  <span class="name"><%= card.name %></span>
                  <span class="meta"><%= card.reward_summary %> · <%= card_annual_fee(card) %> a year</span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </div>
  <% end %>

  <%= link_to "Back to all cards", cards_path, class: "detail-back" %>
</main>
