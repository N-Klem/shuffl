<% content_for :body_class, "browse-page" %>
<% content_for :title, "Browse Cards & Stacks · Shuffl" %>
<div class="browse-app" data-controller="browse" data-browse-payload-value="<%= @browse_payload.to_json %>">
  <div id="stage" class="browse-stage"><noscript>Enable JavaScript to search and compare cards.</noscript></div>
  <div class="tray" id="tray" hidden></div>
  <dialog id="modal"></dialog>
  <div class="toast" role="status" id="toast"></div>
</div>
