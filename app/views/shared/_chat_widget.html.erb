<div class="chat-widget" data-chat-widget>
  <button class="chat-toggle" data-chat-toggle aria-label="Open chat">
    <span class="chat-toggle-icon" data-chat-icon>💬</span>
  </button>
  <div class="chat-panel" data-chat-panel hidden>
    <div class="chat-header">
      <div class="chat-header-info">
        <span class="chat-avatar">S</span>
        <div>
          <strong>Shuffl Advisor</strong>
          <small>Ask anything about credit cards</small>
        </div>
      </div>
      <button class="chat-close" data-chat-toggle aria-label="Close chat">✕</button>
    </div>
    <div class="chat-messages" data-chat-messages>
      <div class="chat-msg chat-msg-bot">
        <span class="chat-msg-avatar">S</span>
        <div class="chat-msg-bubble">Hey! I'm Shuffl's card advisor. Ask me anything about credit cards — I know every card in our database inside and out.</div>
      </div>
    </div>
    <form class="chat-input-row" data-chat-form>
      <input type="text" class="chat-input" data-chat-input placeholder="Ask about any card..." autocomplete="off">
      <button type="submit" class="chat-send">→</button>
    </form>
  </div>
</div>
