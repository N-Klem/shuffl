<nav class="site-nav">
  <div class="container d-flex align-items-center justify-content-between flex-wrap py-3 gap-3">
    <%= link_to "shuffl", root_path, class: "wordmark" %>
    <ul class="nav-links">
      <li><%= link_to "Home", root_path, class: ("active" if current_page?(root_path)) %></li>
      <li><%= link_to "Quiz", new_quiz_response_path, class: ("active" if current_page?(new_quiz_response_path)) %></li>
      <li><%= link_to "Cards", cards_path, class: ("active" if current_page?(cards_path) && params[:tab] != "stacks") %></li>
      <li><%= link_to "Stacks", cards_path(tab: "stacks"), class: ("active" if current_page?(cards_path) && params[:tab] == "stacks") %></li>
      <li><%= link_to "My Wallet", wallet_items_path, class: ("active" if current_page?(wallet_items_path)) %></li>
    </ul>
    <div class="nav-account">
      <% if user_signed_in? %>
        <span class="nav-user">Hi, <%= current_user.first_name %></span>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "nav-signout" %>
      <% else %>
        <%= link_to "Sign in", new_user_session_path, class: "nav-signin #{'active' if current_page?(new_user_session_path)}" %>
        <%= link_to "Create account", new_user_registration_path, class: "nav-cta" %>
      <% end %>
    </div>
  </div>
</nav>
