<%#
  The Shuffl wordmark. The full stop is a drawn circle, not a typed period:
  Geist's period is square and sits too close to the l. See DESIGN.md.

  Options:
    class: extra class for sizing in a given context (e.g. "footer-wordmark")
    link:  false to render a plain span instead of a link home
%>
<% mark_class = ["wordmark", local_assigns[:class]].compact.join(" ") %>
<% if local_assigns.fetch(:link, true) %>
  <%= link_to root_path, class: mark_class, aria: { label: "Shuffl home" } do %>shuffl<span class="wordmark-dot" aria-hidden="true"></span><% end %>
<% else %>
  <span class="<%= mark_class %>">shuffl<span class="wordmark-dot" aria-hidden="true"></span></span>
<% end %>
