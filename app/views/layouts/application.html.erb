<!DOCTYPE html>
<html lang="en">
  <head>
    <script>
      // Inline and synchronous so the theme is set before first paint; moving this
      // into the bundle reintroduces a flash of the wrong theme on every load.
      (() => {
        let stored = null;
        try { stored = localStorage.getItem("shuffl-theme"); } catch (_) {}
        // An explicit choice wins. Otherwise follow the operating system.
        const theme = (stored === "dark" || stored === "light")
          ? stored
          : (window.matchMedia && matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.bsTheme = theme;
      })();
    </script>
    <% page_title = content_for(:title) || "Shuffl" %>
    <% page_description = content_for(:meta_description) || "Shuffl helps you find the credit cards that fit how you actually spend, then build them into a wallet." %>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= page_description %>">
    <meta name="theme-color" content="#601020">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <meta property="og:site_name" content="Shuffl">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:image" content="<%= request.base_url %>/og-image.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png" sizes="512x512">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= content_for(:body_class) %>">
    <%= render "shared/navbar" %>
    <%= render "shared/flash" %>
    <%= yield %>
    <%# The quiz is a focused flow: a full site footer under a four-option
        question reads as the page having run out of content. The assistant
        stays -- help is relevant mid-quiz in a way that legal links are not. %>
    <%= render "shared/footer" unless content_for(:hide_footer).present? %>
    <%= render "shared/assistant" %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
