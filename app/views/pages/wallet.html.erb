<% content_for :title, "My Wallet — Shuffl" %>
<%= render "shared/nav" %>
<main class="wallet-page shell" data-wallet>
  <div class="wallet-header">
    <div>
      <span class="kicker">YOUR COLLECTION</span>
      <h1>My Wallet</h1>
      <p class="wallet-subtitle" data-wallet-count>0 cards in your wallet</p>
    </div>
  </div>

  <div class="wallet-layout">
    <div class="wallet-detail-panel" data-wallet-detail-panel hidden>
      <button class="detail-close" data-detail-close aria-label="Close card details">✕</button>
      <div class="card-detail-top">
        <div class="card-detail-visual" data-detail-visual>
          <div><span class="mini-chip"></span><b data-detail-issuer></b></div>
          <span data-detail-network></span>
          <strong data-detail-name></strong>
          <span data-detail-dots></span>
        </div>
      </div>
      <div class="card-detail-body">
        <div class="card-detail-section">
          <h3>Rewards</h3>
          <div class="detail-rewards" data-detail-rewards></div>
        </div>
        <div class="card-detail-section">
          <h3>Key Details</h3>
          <div class="detail-meta" data-detail-meta></div>
        </div>
        <div class="card-detail-section">
          <h3>Perks</h3>
          <div class="detail-perks" data-detail-perks></div>
        </div>
        <div class="card-detail-section" data-detail-partners-section hidden>
          <h3>Transfer Partners</h3>
          <div class="detail-partners" data-detail-partners></div>
        </div>
        <div class="card-detail-section" data-detail-bonus-section hidden>
          <h3>Sign-Up Bonus</h3>
          <div class="detail-bonus" data-detail-bonus></div>
        </div>
        <div class="card-detail-actions">
          <a class="button card-signup-btn" data-detail-signup href="#" target="_blank">Sign up for this card →</a>
          <button class="button button-secondary card-remove-btn" data-detail-remove>Remove from wallet</button>
        </div>
      </div>
    </div>

    <div class="wallet-spread" data-wallet-spread>
      <!-- Cards injected by JS -->
    </div>
  </div>

  <div class="wallet-nav-links">
    <a href="/results" class="button button-secondary">← Back to results</a>
    <a href="/questionnaire" class="button">Find more cards →</a>
  </div>

  <div class="wallet-empty" data-wallet-empty hidden>
    <div class="wallet-empty-inner">
      <span class="wallet-empty-icon">💳</span>
      <h2>Your wallet is empty</h2>
      <p>Take the quiz and keep cards from your results — they'll show up here.</p>
      <a class="button" href="/questionnaire">Find my cards →</a>
    </div>
  </div>
</main>
<nav class="bottom-nav">
  <a href="/"><span>⌂</span>Home</a>
  <a class="active" href="/wallet"><span>▣</span>Wallet</a>
  <a href="/#stacks"><span>⌕</span>Search</a>
  <a href="#"><span>○</span>Profile</a>
</nav>
