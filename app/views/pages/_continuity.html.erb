<%# Retained for reuse; intentionally not rendered on the homepage. %>
<% if user_signed_in? %>
  <section class="container home-continue">
    <p class="home-continue-greeting">Welcome back, <%= current_user.first_name %>.</p>
    <p class="home-continue-actions">
      <% if current_user.wallet_items.exists? %>
        <%= link_to "Open My Wallet →", wallet_items_path, class: "tertiary-link" %>
        <% if latest_quiz_response %><span class="home-continue-sep">·</span> <%= link_to "View your results", quiz_response_path(latest_quiz_response) %><% end %>
      <% elsif latest_quiz_response %>
        <%= link_to "View your recommended stack →", quiz_response_path(latest_quiz_response), class: "tertiary-link" %>
      <% else %>
        <%= link_to "Take the quiz →", new_quiz_response_path, class: "tertiary-link" %>
      <% end %>
    </p>
  </section>
<% end %>
