<% content_for :title, "Your matched stack — Shuffl" %>
<%= render "shared/nav" %>
<main class="results shell" data-results data-alternatives='<%= raw @alternatives.to_json %>'>
  <div class="result-heading"><div><span class="eyebrow"><span>✦</span> YOUR MATCH IS READY</span><h1>Meet your <em>money stack.</em></h1><p>Three cards. One job each. More rewards, less thinking.</p></div><div class="result-heading-actions"><button class="button share-stack" type="button" data-share-stack>↗ Share my stack</button><a href="/questionnaire" class="button button-secondary">↻ Retake quiz</a></div></div>
  <div class="results-layout">
    <aside class="match-summary"><div class="summary-icon"><%= @stack['icon'] == 'plane' ? '✈︎' : '✦' %></div><span class="kicker">RECOMMENDED FOR YOU</span><h2><%= @stack['name'] %></h2><p><%= @stack['description'] %></p><div class="summary-stat"><span>Projected annual value</span><strong>$<%= @cards.sum { |c| (c['rewards'].values.max * 62) - c['annualFee'] }.round %><small>/ year</small></strong></div><div class="summary-meta"><span><b><%= @cards.length %></b> cards</span><span><b>$<%= @cards.sum { |c| c['annualFee'] } %></b> total fees</span></div><section class="savings-projection" data-savings-projection aria-labelledby="savings-projection-title"><div class="projection-heading"><h3 id="savings-projection-title">Savings projection</h3><output for="monthly-spending" data-spending-output>$1,500</output></div><label for="monthly-spending">Monthly spending</label><input id="monthly-spending" data-spending-slider type="range" min="200" max="5000" step="100" value="1500" style="--slider-progress: 27.08%"><div class="projection-values" aria-live="polite"><p>Annual cashback: <strong data-annual-cashback>$0</strong></p><p>Sign-up bonus value: <strong data-signup-value>$0</strong></p><p>Net after fees: <strong data-net-value>$0</strong></p></div><div class="projection-chart" data-projection-chart aria-label="Annual cashback by card"><span style="--bar-height: 0%"></span><span style="--bar-height: 0%"></span><span style="--bar-height: 0%"></span></div></section><p class="fine-print">Estimate based on typical monthly spending. Your actual rewards may vary.</p></aside>
    <section class="matched-cards" aria-label="Matched cards"><div class="results-skeletons" aria-hidden="true"><div class="skeleton skeleton-card"></div><div class="skeleton skeleton-card"></div><div class="skeleton skeleton-card"></div></div><% @cards.each_with_index do |card,index| %><% match_reasons = [] %><% top_reward = card['rewards'].values.max %><% if params[:top_category].present? && card['rewards'][params[:top_category]] == top_reward %><% match_reasons << "Matches your top spend" %><% end %><% if card['annualFee'] == 0 && params[:fee] == 'none' %><% match_reasons << "No fee, as requested" %><% end %><% loyalty_program = RecommendationService::LOYALTY_MAP[params[:loyalty_program]] %><% if loyalty_program.present? && card['transferPartners'].include?(loyalty_program) %><% match_reasons << "Works with #{loyalty_program}" %><% end %><% credit_limit = RecommendationService::CREDIT_LIMITS[params[:credit_band]] %><% if credit_limit.present? && card['creditScoreMin'] <= credit_limit %><% match_reasons << "Fits your credit profile" %><% end %><article class="result-card" data-card='<%= raw card.to_json %>'><div class="card-visual tone-<%= index + 1 %>"><div><span class="mini-chip"></span><b><%= card['issuer'] %></b></div><span class="network"><%= card['cardNetwork'] %></span><strong><%= card['name'] %></strong><span>•••• <%= 4829 + index * 813 %></span></div><div class="card-body"><span class="card-role"><%= %w[EVERYDAY SPECIALIST BACKUP][index] %></span><div class="card-match-reasons"><% match_reasons.first(2).each do |reason| %><span><%= reason %></span><% end %></div><h3><%= link_to card['name'], card_detail_path(card['id']), class: "card-name-link" %></h3><p>Best for <%= card['categories'].first(2).join(' & ') %>, with rewards that fit this stack.</p><div class="tags"><% card['perks'].first(3).each do |perk| %><span><%= perk %></span><% end %></div><div class="reward-line"><span>Top reward</span><strong>+<%= card['rewards'].values.max %>× back</strong></div><div class="card-actions"><button class="button keep-card" type="button">♡ Keep</button><button class="button button-secondary swap-card" type="button">↻ Swap</button><button class="button button-secondary compare-card" type="button" aria-pressed="false">＋ Compare</button></div></div></article><% end %></section>
  </div>
  <div class="results-footer"><p><span data-kept-count>0</span> saved · <span data-compare-count>0</span> selected</p><a class="button button-secondary compare-link" href="/compare" aria-disabled="true">Compare cards</a><a class="button" href="/wallet">View My Wallet →</a></div>
</main>
