<% content_for :title, "Your matched stack — Shuffl" %>
<%= render "shared/nav" %>
<main class="results shell" data-results data-alternatives='<%= raw @alternatives.to_json %>'>
  <div class="result-heading"><div><span class="eyebrow"><span>✦</span> YOUR MATCH IS READY</span><h1>Meet your <em>money stack.</em></h1><p>Three cards. One job each. More rewards, less thinking.</p></div><a href="/questionnaire" class="button button-secondary">↻ Retake quiz</a></div>
  <div class="results-layout">
    <aside class="match-summary"><div class="summary-icon"><%= @stack['icon'] == 'plane' ? '✈︎' : '✦' %></div><span class="kicker">RECOMMENDED FOR YOU</span><h2><%= @stack['name'] %></h2><p><%= @stack['description'] %></p><div class="summary-stat"><span>Projected annual value</span><strong>$<%= @cards.sum { |c| (c['rewards'].values.max * 62) - c['annualFee'] }.round %><small>/ year</small></strong></div><div class="summary-meta"><span><b><%= @cards.length %></b> cards</span><span><b>$<%= @cards.sum { |c| c['annualFee'] } %></b> total fees</span></div><p class="fine-print">Estimate based on typical monthly spending. Your actual rewards may vary.</p></aside>
    <section class="matched-cards" aria-label="Matched cards"><% @cards.each_with_index do |card,index| %><article class="result-card" data-card='<%= raw card.to_json %>'><div class="card-visual tone-<%= index + 1 %>"><div><span class="mini-chip"></span><b><%= card['issuer'] %></b></div><span class="network"><%= card['cardNetwork'] %></span><strong><%= card['name'] %></strong><span>•••• <%= 4829 + index * 813 %></span></div><div class="card-body"><span class="card-role"><%= %w[EVERYDAY SPECIALIST BACKUP][index] %></span><h3><%= card['name'] %></h3><p>Best for <%= card['categories'].first(2).join(' & ') %>, with rewards that fit this stack.</p><div class="tags"><% card['perks'].first(3).each do |perk| %><span><%= perk %></span><% end %></div><div class="reward-line"><span>Top reward</span><strong>+<%= card['rewards'].values.max %>× back</strong></div><div class="card-actions"><button class="button keep-card" type="button">♡ Keep</button><button class="button button-secondary swap-card" type="button">↻ Swap</button></div></div></article><% end %></section>
  </div>
  <div class="results-footer"><p><span data-kept-count>0</span> cards saved to your wallet</p><a class="button" href="/wallet">View My Wallet →</a></div>
</main>
