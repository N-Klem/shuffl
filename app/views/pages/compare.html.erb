<% content_for :title, "Compare cards — Shuffl" %>
<%= render "shared/nav" %>
<main class="compare-page shell" data-compare>
  <header class="compare-heading">
    <span class="eyebrow"><span>✦</span> CARD COMPARISON</span>
    <h1>See how your cards <em>stack up.</em></h1>
    <p>Compare fees, rewards, perks, and partners side by side.</p>
  </header>

  <% if @cards.length < 2 %>
    <section class="compare-empty">
      <h2>Choose at least two cards to compare</h2>
      <p>Select two to four cards from your recommendations for a useful side-by-side view.</p>
      <a class="button" href="/results">Browse recommendations →</a>
    </section>
  <% else %>
    <div class="compare-scroll" role="region" aria-label="Credit card comparison" tabindex="0">
      <table class="compare-table" style="--card-count: <%= @cards.length %>">
        <thead><tr><th scope="col"><span class="compare-label">Cards</span></th>
          <% @cards.each_with_index do |card, index| %><th scope="col"><div class="compare-card-visual tone-<%= (index % 3) + 1 %>"><div><span class="mini-chip"></span><b><%= card['issuer'] %></b></div><strong><%= card['name'] %></strong><span><%= card['cardNetwork'] %></span></div></th><% end %>
        </tr></thead>
        <tbody>
          <% details = [
            ['Annual Fee', ->(c) { c['annualFee'].zero? ? '$0' : "$#{c['annualFee']}" }],
            ['Credit Score Min', ->(c) { c['creditScoreMin'] }],
            ['Points Currency', ->(c) { c['pointsCurrency'] }],
            ['Foreign Transaction Fee', ->(c) { c['foreignTransactionFee'] ? 'Yes' : 'None' }],
            ['Sign-Up Bonus', ->(c) { c.dig('signUpBonus', 'amount').zero? ? 'No bonus' : "#{number_with_delimiter(c.dig('signUpBonus', 'amount'))} points after $#{number_with_delimiter(c.dig('signUpBonus', 'spend'))} in #{c.dig('signUpBonus', 'months')} months" }]
          ] %>
          <% details.each do |label, value| %><tr><th scope="row"><%= label %></th><% @cards.each do |card| %><td><%= value.call(card) %></td><% end %></tr><% end %>

          <tr class="compare-section-row"><th colspan="<%= @cards.length + 1 %>"><h2>Rewards</h2><p>Multipliers by spending category</p></th></tr>
          <% @reward_categories.each do |category| %>
            <% highest = @cards.map { |card| card.dig('rewards', category).to_f }.max %>
            <tr class="reward-compare-row"><th scope="row"><%= category.titleize %></th>
              <% @cards.each do |card| value = card.dig('rewards', category).to_f %><td class="<%= 'reward-best' if value == highest %>"><div class="compare-bar"><span style="width:<%= value / 6.0 * 100 %>%"></span></div><b><%= number_with_precision(value, precision: 1, strip_insignificant_zeros: true) %>×</b></td><% end %>
            </tr>
          <% end %>

          <tr class="compare-section-row"><th colspan="<%= @cards.length + 1 %>"><h2>Perks</h2></th></tr>
          <% @perks.each do |perk| %><tr class="feature-row"><th scope="row"><%= perk %></th><% @cards.each do |card| %><td><span class="feature-check <%= 'included' if card['perks'].include?(perk) %>"><%= card['perks'].include?(perk) ? '✓' : '—' %></span></td><% end %></tr><% end %>

          <tr class="compare-section-row"><th colspan="<%= @cards.length + 1 %>"><h2>Transfer Partners</h2></th></tr>
          <% if @transfer_partners.any? %>
            <% @transfer_partners.each do |partner| %><tr class="feature-row"><th scope="row"><%= partner %></th><% @cards.each do |card| %><td><span class="feature-check <%= 'included' if card['transferPartners'].include?(partner) %>"><%= card['transferPartners'].include?(partner) ? '✓' : '—' %></span></td><% end %></tr><% end %>
          <% else %>
            <tr><th scope="row">Partners</th><% @cards.each do |_card| %><td class="muted-cell">None</td><% end %></tr>
          <% end %>

          <tr class="compare-actions-row"><th></th><% @cards.each do |card| %><td><button class="button add-compare-wallet" type="button" data-card='<%= raw card.to_json %>'>＋ Add to wallet</button></td><% end %></tr>
        </tbody>
      </table>
    </div>
  <% end %>
</main>
