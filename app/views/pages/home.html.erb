<% content_for :body_class, "home-page" %>
<section class="hero container product-hero">
  <div class="hero-copy">
    <div class="hero-headline"><h1><span>find your cards</span><span>build your wallet</span></h1></div>
    <p class="hero-description">Compare credit cards for how you spend.<br>Find a few that work together, in one wallet.</p>
    <div class="hero-actions">
      <%= link_to "Take the quiz", new_quiz_response_path, class: "btn btn-primary", aria: { describedby: "quiz-expectations" } %>
      <%= link_to "Browse cards & stacks", cards_path, class: "btn btn-outline-dark" %>
    </div>
    <p class="home-caption" id="quiz-expectations">Up to <%= Card::CORE_QUESTIONS.size %> questions. No account needed to see your results. Save and finish later if you need a break.</p>
  </div>
  <div class="hero-stacks" data-controller="hero-stacks" role="region" aria-roledescription="carousel" aria-label="Featured stacks">
    <% @featured_stacks.each_with_index do |stack, index| %>
      <div id="hero-stack-<%= index %>" data-hero-stacks-target="panel" data-label="Stack <%= index + 1 %> of <%= @featured_stacks.size %> · <%= stack.name %>" <%= "hidden" unless index.zero? %>>
        <div class="stack-tile" data-controller="stack">
          <div class="stack-fan">
            <% stack.cards.first(4).each do |card| %>
              <div class="fan-card <%= card_finish(card) %>" data-card-name="<%= card.name %>" data-card-benefit="<%= card_benefit(card) %>" data-card-fee="<%= number_to_currency(card.annual_fee, precision: 0) %>">
                <div class="chip"></div>
                <span class="card-wordmark">shuffl.</span>
                <div class="card-reveal"><span class="name"><%= card.name %></span><span class="benefit"><%= card_benefit(card) %></span></div>
              </div>
            <% end %>
          </div>
          <div class="stack-card-info" aria-live="polite"></div>
          <div class="stack-tile-footer"><h2><button type="button" data-stack-target="toggle" aria-expanded="false" aria-label="Reveal <%= stack.name %> cards"><%= stack.name %><span class="stack-hint" aria-hidden="true">Explore stack <span>↗</span></span></button></h2></div>
        </div>
        <%= link_to "View #{stack.name} stack →", stack_path(stack), class: "hero-stack-link" %>
      </div>
    <% end %>
    <div id="hero-stack-more" class="hero-stacks-more" data-hero-stacks-target="panel" data-label="Explore more stacks" <%= "hidden" if @featured_stacks.any? %>>
      <div class="ghost-stack" aria-hidden="true">
        <% 4.times do %><span class="ghost-card"><span class="ghost-chip"></span><span class="ghost-wordmark"><%= render "shared/wordmark", link: false %></span></span><% end %>
      </div>
      <%= link_to stacks_path, class: "ghost-stack-link tertiary-link" do %>
        <span>Explore more stacks</span><span aria-hidden="true">↗</span>
      <% end %>
    </div>
    <div class="hero-stacks-controls">
      <div class="hero-stacks-rail" style="--stack-count: <%= @featured_stacks.size + 1 %>" aria-label="Choose a stack">
        <% @featured_stacks.each_with_index do |stack, index| %>
          <button type="button" data-hero-stacks-target="selector" data-action="hero-stacks#select" data-index="<%= index %>" aria-controls="hero-stack-<%= index %>" aria-label="Show <%= stack.name %> stack" aria-pressed="<%= index.zero? %>"></button>
        <% end %>
        <button type="button" data-hero-stacks-target="selector" data-action="hero-stacks#select" data-index="<%= @featured_stacks.size %>" aria-controls="hero-stack-more" aria-label="Show explore more stacks" aria-pressed="<%= @featured_stacks.empty? %>"></button>
      </div>
      <div class="hero-stacks-position">
        <span data-hero-stacks-target="status" aria-live="polite"></span>
        <div class="hero-stacks-arrows">
          <button type="button" data-action="hero-stacks#previous" aria-label="Previous stack">←</button>
          <button type="button" data-action="hero-stacks#next" aria-label="Next stack">→</button>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="container home-explainer" aria-labelledby="how-it-works-title">
  <div class="row g-4">
    <div class="col-md-6">
      <h2 id="how-it-works-title">one wallet. different jobs.</h2>
      <p>One card for groceries. Another for travel. A stack brings cards with different strengths into one wallet.</p>
      <p>Your stack is a shortlist, not a to-do list. Keep what fits — there’s no need to apply for every card.</p>
    </div>
    <div class="col-md-6">
      <ol class="home-steps">
        <li><h3>Tell us what matters</h3><p>Your spending. Your priorities. Your comfort with fees.</p></li>
        <li><h3>Explore your matches</h3><p>Compare benefits and fees. Swap cards to find your fit.</p></li>
        <li><h3>Keep your shortlist</h3><p>Save your picks with an account. No applications submitted.</p></li>
      </ol>
    </div>
  </div>
</section>
