<% content_for :body_class, "home-page" %>
<section class="hero container product-hero">
  <div class="hero-copy">
    <div class="hero-headline"><h1><span>find your cards</span><span>build your wallet</span></h1></div>
    <p class="hero-description">Find the cards that fit your life.<br>Build a stack that works better together.</p>
    <div class="hero-actions">
      <%= link_to "Find my cards", new_quiz_response_path, class: "btn btn-primary" %>
      <%= link_to "Browse cards & stacks", cards_path, class: "btn btn-outline-dark" %>
    </div>
  </div>
  <% hero_cards = @featured_stacks.flat_map { |stack| stack.cards.first(2) }.uniq.first(5) %>
  <% if hero_cards.any? %>
    <div class="hero-carousel" data-controller="hero-carousel" aria-label="Explore cards for your stack" aria-roledescription="carousel">
      <div class="hero-wheel">
        <% hero_cards.each_with_index do |card, index| %>
          <button type="button" class="fan-card hero-card <%= card_finish(card) %>" data-hero-carousel-target="card" data-action="hero-carousel#select" data-index="<%= index %>" data-caption="<%= card_benefit(card) %>" aria-label="Bring <%= card.name %> forward">
            <span class="chip"></span><span class="card-wordmark">shuffl.</span>
            <span class="hero-card-name"><%= card.name %></span>
          </button>
        <% end %>
      </div>
      <div class="hero-carousel-footer"><span data-hero-carousel-target="caption"><%= card_benefit(hero_cards.first) %></span></div>
    </div>
  <% end %>
</section>

<section class="stacks container">
  <div class="row g-4">
    <% @featured_stacks.each do |stack| %>
      <div class="col-md-4 stack-col">
        <div class="stack-tile" data-controller="stack">
          <div class="stack-fan">
            <% stack.cards.first(4).each do |card| %>
              <div class="fan-card <%= card_finish(card) %>">
                <div class="chip"></div>
                <span class="card-wordmark">shuffl.</span>
                <div class="card-reveal"><span class="name"><%= card.name %></span><span class="benefit"><%= card_benefit(card) %></span></div>
              </div>
            <% end %>
          </div>
          <div class="stack-tile-footer"><h2><button type="button" data-stack-target="toggle" aria-expanded="false" aria-label="Reveal <%= stack.name %> cards"><%= stack.name %><span class="stack-hint" aria-hidden="true">Explore stack <span>↗</span></span></button></h2></div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="stacks-footer">
    <p>Explore by what matters to you.</p>
    <%= link_to "Explore more stacks →", stacks_path, class: "tertiary-link" %>
  </div>
</section>
