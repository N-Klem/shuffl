<% content_for :body_class, "home-page" %>
<section class="hero container">
  <div class="hero-headline">
    <h1><span>find your cards</span><span>build your wallet</span></h1>
  </div>
  <div class="hero-actions">
    <%= link_to "Take the quiz", new_quiz_response_path, class: "btn btn-primary" %>
    <%= link_to "Browse stacks", stacks_path, class: "btn btn-outline-dark" %>
  </div>
</section>

<section class="stacks container">
  <div class="row g-4">
    <% @featured_stacks.each do |stack| %>
      <div class="col-md-4 stack-col">
        <div class="stack-tile" data-controller="stack">
          <div class="stack-fan">
            <% stack.cards.first(4).each do |card| %>
              <div class="fan-card <%= card_finish(card) %>">
                <div class="chip"></div>
                <span class="card-wordmark">shuffl</span>
                <div class="card-reveal"><span class="name"><%= card.name %></span><span class="benefit"><%= card_benefit(card) %></span></div>
              </div>
            <% end %>
          </div>
          <div class="stack-tile-footer"><h2><button type="button" data-stack-target="toggle" aria-expanded="false" aria-label="Reveal <%= stack.name %> cards"><%= stack.name %><span class="stack-hint" aria-hidden="true">Explore stack <span>↗</span></span></button></h2></div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="stacks-footer">
    <p>Explore by what matters to you.</p>
    <%= link_to "Explore more stacks →", stacks_path, class: "tertiary-link" %>
  </div>
</section>

<div data-controller="dialog">
  <button type="button" class="ai-bubble" data-action="dialog#open" aria-haspopup="dialog">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 3h14a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2h-8l-6 4v-4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/></svg>
    <span class="label">Ask shuffl<span class="sublabel">AI assistant</span></span>
  </button>
  <dialog class="ai-dialog" data-dialog-target="dialog" data-action="click->dialog#backdrop" aria-labelledby="ai-dialog-title">
    <div class="ai-dialog-body">
      <p class="eyebrow">Coming soon</p>
      <h2 id="ai-dialog-title">Ask shuffl is on its way.</h2>
      <p>Until it lands, the quiz is the fastest route to a card that fits: <%= Card::QUIZ_QUESTIONS.size %> questions, about two minutes, and every one of our <%= Card.count %> cards ranked against how you spend.</p>
      <div class="ai-dialog-actions">
        <%= link_to "Take the quiz", new_quiz_response_path, class: "btn btn-primary" %>
        <button type="button" class="btn btn-outline-dark" data-action="dialog#close">Not now</button>
      </div>
    </div>
  </dialog>
</div>
