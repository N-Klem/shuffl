<% content_for :title, "Shuffl — Credit cards, without the confusion" %>
<%= render "shared/nav" %>
<main><section class="hero shell"><div class="hero-copy"><span class="eyebrow"><span>✦</span> Smart card matching</span><h1>Credit cards, without<br>the <em>confusion.</em></h1><p class="subtitle">You're already spending. We'll match you with cards that turn your spending into real rewards — cashback and points, without the fine print.</p><a class="button hero-button" href="/questionnaire">Build my stack <span>→</span></a><div class="trust-row"><span>Free forever</span><span>No credit check</span><span>Takes 60 seconds</span></div></div><div class="hero-visual" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="demo-card card-back"><span>EVERYDAY</span><strong>3×</strong></div><div class="demo-card card-front"><div class="demo-top"><span class="chip"></span><b>shuffl</b></div><div><small>THIS MONTH</small><strong>+$184</strong></div><p>•••• 4829</p></div><span class="float-pill pill-top">+4× dining</span><span class="float-pill pill-bottom">$0 annual fee</span></div></section><section class="stacks-section shell" id="stacks"><div class="section-heading"><div><span class="kicker">CURATED FOR YOU</span><h2>Or start from a ready-made stack</h2></div><p><a class="text-link" href="/explore">Explore all cards <b>→</b></a></p></div><div class="stack-row"><% @stacks.each_with_index do |stack, index| %><a class="stack-card" href="/results?stack=<%= stack['id'] %>"><div class="stack-icon"><%= %w[✈︎ ◒ ✦ ⚡ $][index] %></div><span class="card-count"><%= stack['cardIds'].length %> cards</span><h3><%= stack['name'] %></h3><p><%= stack['description'] %></p><span class="text-link">View this stack <b>→</b></span></a><% end %></div></section></main>
