<% content_for :body_class, "quiz-page" %>
<% content_for :hide_footer, true %>
<% content_for :title, "Question #{@step} of #{@total} — Shuffl" %>
<main class="quiz-shell" data-controller="quiz" data-quiz-limit-value="<%= [ :multi, :ranked ].include?(@question[:type]) ? @question[:max_select] : 1 %>"
  data-quiz-ranked-value="<%= @question[:type] == :ranked %>">
  <div class="quiz-progress">
    <div class="quiz-progress-copy"><span>Question <%= @step %> of <%= @total %></span><span><%= ((@step - 1).fdiv(@total) * 100).round %>% complete</span></div>
    <div class="quiz-bubbles" role="progressbar" aria-label="Quiz completion" aria-valuemin="0" aria-valuemax="<%= @total %>" aria-valuenow="<%= @step - 1 %>" aria-valuetext="Question <%= @step %> of <%= @total %>; <%= @step - 1 %> completed">
      <% @total.times do |index| %>
        <span aria-hidden="true" class="quiz-bubble <%= 'is-complete' if index < @step - 1 %> <%= 'is-current' if index == @step - 1 %>"></span>
      <% end %>
    </div>
  </div>

  <header class="quiz-heading">
    <h1 tabindex="-1" data-quiz-target="heading"><%= quiz_question_heading(@question) %></h1>
    <p><%= quiz_question_explanation(@question) %></p>
  </header>

  <%= form_with url: quiz_responses_path, method: :post, data: { quiz_target: "form", action: "submit->quiz#submitting turbo:submit-end->quiz#finished" } do %>
    <%= hidden_field_tag :step, @current_index %>
    <%= hidden_field_tag :question_key, @question[:key] %>
    <%= hidden_field_tag :quiz_token, session[:quiz_token] %>
    <% if @question[:type] == :ranked %>
      <%= hidden_field_tag :ordered, @selected.join(""), data: { quiz_target: "ordered" } %>
    <% end %>
    <% if @question[:type] == :ranked %>
      <div class="rank-board" data-quiz-target="board" hidden>
        <div class="rank-column"><p class="rank-caption">YOUR TOP THREE <span>Most important first</span></p><div data-quiz-target="slots" class="rank-slots"></div></div>
        <div class="rank-cloud-column"><p class="rank-caption">MAKE IT YOURS <span>Drag a choice into a slot, or tap to add</span></p><div data-quiz-target="pool" class="rank-cloud" aria-label="Available choices"></div></div>
      </div>
    <% end %>
    <fieldset aria-describedby="quiz-status" class="<%= 'rank-fallback' if @question[:type] == :ranked %>">
      <legend class="visually-hidden"><%= @question[:prompt] %></legend>
      <div class="quiz-options <%= "quiz-options-many" if @question[:options].size > 6 %>">
        <% @question[:options].each_with_index do |option, index| %>
          <% rank = @question[:type] == :ranked ? @selected.index(option) : nil %>
          <label class="quiz-answer <%= "is-ranked" if rank %>" for="quiz-answer-<%= index %>" data-quiz-target="option">
            <% if @question[:type] == :ranked %>
              <%= check_box_tag "answer[]", option, rank.present?, id: "quiz-answer-#{index}", data: { quiz_target: "answer", action: "change->quiz#choose" } %>
              <span class="quiz-rank" aria-hidden="true"><%= rank ? rank + 1 : "" %></span>
            <% elsif @question[:type] == :multi %>
              <%= check_box_tag "answer[]", option, @selected.include?(option), id: "quiz-answer-#{index}", data: { quiz_target: "answer", action: "change->quiz#choose" } %>
            <% else %>
              <%= radio_button_tag "answer", option, @selected.include?(option), id: "quiz-answer-#{index}", data: { quiz_target: "answer", action: "change->quiz#choose click->quiz#reselect" } %>
            <% end %>
            <span><%= option %></span>
          </label>
        <% end %>
      </div>
    </fieldset>
    <p class="quiz-status" id="quiz-status" role="status" data-quiz-target="status"><%= @error %></p>
    <div class="quiz-controls">
      <% if @previous_step %>
        <%= link_to "Back", new_quiz_response_path(step: @previous_step), class: "quiz-back", data: { action: "click->quiz#cancel", turbo_prefetch: false } %>
      <% else %>
        <%= link_to "Back", root_path, class: "quiz-back", data: { action: "click->quiz#cancel", turbo_prefetch: false } %>
      <% end %>
      <% if [ :multi, :ranked ].include?(@question[:type]) %>
        <button class="btn btn-primary quiz-done" type="submit" data-quiz-target="done"><%= @question[:type] == :ranked ? "Continue" : "Done selecting" %></button>
      <% end %>
      <noscript><button class="btn btn-primary" type="submit">Continue</button></noscript>
    </div>
  <% end %>

  <% if @step > 1 %>
    <%= form_with url: save_progress_quiz_responses_path, method: :post, class: "quiz-save" do %>
      <button type="submit" class="quiz-save-link">
        <%= user_signed_in? ? "Save and finish later" : "Save and finish later — we'll ask you to sign in" %>
      </button>
    <% end %>
  <% end %>
</main>
