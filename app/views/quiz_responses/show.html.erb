<% content_for :body_class, "results-page" %>
<% content_for :title, "Your recommended stack · Shuffl" %>
<% content_for :meta_description, "#{@cards.size} cards chosen from #{Card.available.count}, matched to how you spend. Explore its rates and terms." %>
<% if @cards.empty? %>
<main class="results-main">
  <header>
    <div>
      <h1>No matching stack yet.</h1>
      <% if @quiz_response.answers_hash["credit_score"] == "I don't know" %>
        <p>We need your credit score range to match cards to your current profile. You can return when you know it.</p>
      <% else %>
        <p>Our current catalogue does not have a supported match for your credit profile, preferences and fee budget.</p>
      <% end %>
      <p>This is not a credit decision or a rejection. We have not checked your credit or submitted an application.</p>
      <%= link_to "Retake the quiz", new_quiz_response_path, class: "btn btn-primary" %>
    </div>
  </header>
</main>
<% else %>
<main class="results-main" data-controller="results quiz-finish" data-quiz-finish-enabled-value="<%= @show_quiz_finish %>"
      data-results-payload-value="<%= @results_payload.to_json %>"
      data-results-quiz-id-value="<%= @quiz_response.id %>"
      data-results-save-url-value="<%= save_stack_wallet_items_path %>">
<div id="results">
<noscript><p>Enable JavaScript to keep or swap cards and save this stack.</p></noscript>
<header>
  <div><h1>Your spending. More <span class="keyword-emphasis">rewarding.</span></h1><p><%= @cards.one? ? "Your recommended card, and how to use it." : "Your recommended cards, and what to use each one for." %></p></div>
  <div class="save-area"><button id="save-stack" type="button">Save this stack</button><p id="save-status" role="status">Save these cards to My Wallet.</p></div>
</header>
<section class="results-recommendations" aria-label="Your recommended cards">
<div class="cards-heading"><strong>Your recommended stack</strong><span id="kept-count"></span></div><div id="cards">
<% @cards.each do |card| %>
  <article class="recommendation"><div><h2><%= card.name %></h2><p><%= card.issuer %></p><%= link_to "Explore this card", card_path(card) %></div><p>Annual fee: <%= number_to_currency(card.annual_fee) %></p></article>
<% end %>
</div><p class="status" id="status" role="status">Keep your favourites. Swap anything that doesn’t feel right.</p><% if @quiz_response.answers_hash["credit_score"] == "I don't know" %><p class="footnote">You skipped your credit score, so these matches don't account for it. Check each issuer's guidance before applying.</p><% elsif @relaxed[:credit] %><p class="footnote">We couldn't match your credit range exactly, so these are the closest fits. Check each issuer's guidance before applying.</p><% end %><% if @relaxed[:budget] %><p class="footnote">Nothing in the catalogue fits under your <%= number_to_currency(@quiz_response.answers_hash["annual_fee_budget"].to_d, precision: 0) %> budget, so this is the closest stack. Its fees come to <%= number_to_currency(@cards.sum { |card| card.annual_fee.to_d }, precision: 0) %> a year.</p><% end %><p class="footnote">Save your shortlist to revisit these cards in <%= link_to "My Wallet", wallet_items_path %>.</p></section></div>
<footer class="bottom"><p id="results-notes">Compare the researched card benefits and earning conditions. Check current fees, eligibility and offer terms with the issuer before applying.</p><span><%= render "shared/wordmark", link: false %> · Your results</span></footer>
</main>

<template id="quiz-finish-template">
  <div class="quiz-finish-overlay" role="status" aria-live="polite" aria-label="Building your stack">
    <div class="finish-orbit" aria-hidden="true">
      <% 8.times do |index| %><span class="orbit-position" style="--orbit-index:<%= index %>"><span class="orbit-card"><span></span></span></span><% end %>
    </div>
    <div class="finish-wordmark" aria-hidden="true">
      <%= render "shared/wordmark", class: "finish-wordmark-outline", link: false %>
      <%= render "shared/wordmark", class: "finish-wordmark-fill", link: false %>
    </div>
  </div>
</template>

<% end %>
