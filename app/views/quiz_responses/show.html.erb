<% content_for :body_class, "results-page" %>
<% content_for :title, "Your recommended stack · Shuffl" %>
<% content_for :meta_description, "#{@cards.size} cards chosen from #{Card.count}, matched to how you spend. See the stack and what it earns." %>
<main class="results-main" data-controller="results quiz-finish" data-quiz-finish-enabled-value="<%= @show_quiz_finish %>"
      data-results-payload-value="<%= @results_payload.to_json %>"
      data-results-quiz-id-value="<%= @quiz_response.id %>"
      data-results-save-url-value="<%= save_stack_wallet_items_path %>">
<div id="results">
<noscript><p>Enable JavaScript to adjust spending, keep or swap cards, and save this stack.</p></noscript><header><div><h1>Your spending. More <span class="keyword-emphasis">rewarding.</span></h1><p><%= @cards.size %> cards, working together. A stack that fits your everyday.</p></div><div class="save-area"><button id="save-stack" type="button">Save this stack</button><p id="save-status" role="status">Save these cards to My Wallet.</p><div class="share-area" data-controller="share" data-share-title-value="My Shuffl stack"><button type="button" class="share-button" data-action="share#share">Share this stack</button><p class="share-status" data-share-target="status" role="status"></p></div></div></header><div class="layout">
<aside class="summary" aria-label="Stack value and signup timeline"><h2>Your stack’s annual value</h2><div class="total" id="total" aria-live="polite"></div><p class="caption">Estimated rewards, after annual fees</p><div class="spend"><div class="label-row"><label for="spend">Your monthly spending</label><output for="spend" id="spend-value"></output></div><input type="range" id="spend" min="0" max="10000" step="1" value="2500"><div class="range-labels"><span>$0</span><span>$10,000</span></div><details class="fine-tune"><summary>Fine-tune your spending</summary><p class="caption">Adjust each category. Your monthly total updates with you.</p><div id="category-sliders"></div><p class="caption">The main slider scales this spending mix.</p></details></div><dl class="breakdown"><div><dt>Yearly rewards</dt><dd id="gross"></dd></div><div><dt>Annual fees</dt><dd id="fees"></dd></div></dl><section class="timeline"><h3>Build your stack, one at a time.</h3><p class="caption">An example signup sequence</p><ol id="timeline"></ol></section><p class="footnote">Timing is illustrative. Review eligibility and each card’s terms before applying.</p></aside>
<section aria-label="Your recommended cards"><div class="cards-heading"><strong>Your recommended stack</strong><span id="kept-count"></span></div><div id="cards">
<% @cards.each do |card| %>
  <article class="recommendation"><div><h2><%= card.name %></h2><p><%= card.issuer %></p><%= link_to "Explore this card", card_path(card) %></div><p>Annual fee: <%= number_to_currency(card.annual_fee) %></p></article>
<% end %>
</div><p class="status" id="status" role="status">Keep your favourites. Swap anything that doesn’t feel right.</p><p class="footnote">Spending is shared across your cards, counted only once. Move the slider to see each card’s contribution change.</p></section></div></div>
<footer class="bottom"><p>Illustrative estimates from Shuffl’s sample catalogue, not live offers. Points are valued at 1¢ each. Excludes welcome bonuses, interest, category caps and conditional perks. Each spending category is counted once, on the highest-rate card in your stack.</p><span><%= render "shared/wordmark", link: false %> · Your results</span></footer>
</main>

<template id="quiz-finish-template">
  <div class="quiz-finish-overlay" role="status" aria-live="polite" aria-label="Building your stack">
    <div class="finish-orbit" aria-hidden="true">
      <% 8.times do |index| %><span class="orbit-position" style="--orbit-index:<%= index %>"><span class="orbit-card"><span></span></span></span><% end %>
    </div>
    <div class="finish-wordmark" aria-hidden="true">
      <%= render "shared/wordmark", class: "finish-wordmark-outline", link: false %>
      <%= render "shared/wordmark", class: "finish-wordmark-fill", link: false %>
    </div>
  </div>
</template>
