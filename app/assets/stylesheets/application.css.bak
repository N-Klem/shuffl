@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');
:root{--ink:#ffffff;--panel:#ffffff;--line:#e5e5ea;--muted:#6b6b7b;--text:#1a1a2e;--purple:#6c63ff;--mint:#00d4aa;--tone-1:linear-gradient(145deg,#6c63ff,#4a3fd4);--tone-2:linear-gradient(145deg,#16b89a,#0a7a65);--tone-3:linear-gradient(145deg,#8b87a5,#5a576e);--tone-4:linear-gradient(145deg,#e85d75,#b8344d);--tone-5:linear-gradient(145deg,#f0a030,#c07818);--tone-6:linear-gradient(145deg,#3498db,#2176ad);--display:"Space Grotesk",sans-serif;--body:"DM Sans",sans-serif}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--ink);color:var(--text);font:16px/1.6 var(--body);min-height:100vh;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}a{color:inherit;text-decoration:none}button,input{font:inherit}button:focus-visible,input:focus-visible{outline:2px solid var(--purple);outline-offset:2px;transition:outline-color 180ms cubic-bezier(0.25,0.1,0.25,1)}

/* Loading skeletons */
.skeleton{background:linear-gradient(90deg,#ededf1 0%,#fff 50%,#ededf1 100%);background-size:200% 100%;animation:skeletonShimmer 1.5s linear infinite}
.skeleton-card{width:280px;height:350px;border-radius:16px}
.skeleton-text{width:100%;height:16px;border-radius:6px}
.skeleton-heading{width:60%;height:32px;border-radius:8px}
@keyframes skeletonShimmer{from{background-position:200% 0}to{background-position:-200% 0}}

/* Shell */
.shell{width:min(1180px,calc(100% - 40px));margin:auto}

/* Nav */
.site-nav{height:72px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);padding:0 max(24px,calc((100vw - 1180px)/2));background:#ffffffee;backdrop-filter:blur(18px);position:relative;z-index:20}
.brand{font:700 22px var(--display);display:flex;align-items:center;gap:10px;color:var(--text)}
.brand-mark{width:30px;height:30px;border-radius:8px;display:grid;place-items:center;background:var(--purple);color:#fff;transform:rotate(-7deg);font-size:14px;font-weight:700}
.desktop-links{display:flex;gap:34px;color:var(--muted);font-size:14px}
.desktop-links a:hover{color:var(--text)}
.nav-actions{display:flex;align-items:center;gap:14px}
.avatar{width:34px;height:34px;border:1px solid var(--line);border-radius:50%;display:grid;place-items:center;background:#f5f5f7;font-size:13px;color:var(--muted)}
.theme-toggle{width:38px;height:38px;padding:0;border:1px solid var(--line);border-radius:10px;background:var(--panel);color:var(--text);cursor:pointer;display:grid;place-items:center;transition:background-color 180ms ease,border-color 180ms ease,transform 180ms ease}
.theme-toggle:hover{border-color:var(--purple);transform:translateY(-1px)}
.theme-icon{grid-area:1/1;font-size:19px;line-height:1;transition:opacity 180ms ease,transform 180ms ease}.theme-icon-sun{opacity:0;transform:rotate(-45deg) scale(.7)}
:root[data-theme="dark"] .theme-icon-moon{opacity:0;transform:rotate(45deg) scale(.7)}:root[data-theme="dark"] .theme-icon-sun{opacity:1;transform:none}

/* Buttons */
.button{border:0;border-radius:10px;background:var(--purple);color:#fff;display:inline-flex;align-items:center;justify-content:center;gap:14px;padding:16px 24px;font-weight:600;cursor:pointer;transition:transform 180ms cubic-bezier(0.25,0.1,0.25,1),box-shadow 180ms cubic-bezier(0.25,0.1,0.25,1),background-color 180ms cubic-bezier(0.25,0.1,0.25,1);font-size:15px}
.button:hover{transform:translateY(-1px);background:#5b52f0;box-shadow:0 4px 12px #0002}
.button:active{transform:scale(.97);transition-duration:100ms}
.button-small{font-size:13px;padding:8px 16px}
.button-secondary{background:#f5f5f7;border:1px solid var(--line);color:var(--text)}
.button-secondary:hover{background:#ebebef;transform:translateY(-1px)}

/* Typography */
h1,h2,h3{font-family:var(--display);line-height:1.1;letter-spacing:-.02em;margin:0}
.eyebrow,.kicker{font-size:11px;line-height:1.5;letter-spacing:.12em;font-weight:700;text-transform:uppercase}
.eyebrow{display:inline-flex;gap:8px;align-items:center;border:1px solid var(--line);background:#f9f9fb;border-radius:99px;padding:8px 16px;color:var(--muted)}
.eyebrow span,.kicker{color:var(--purple)}

/* Hero */
.hero{min-height:540px;display:grid;grid-template-columns:1.1fr .9fr;align-items:center;padding:48px 0 40px}
.hero h1{font-size:clamp(42px,5.5vw,68px);margin:24px 0 16px;color:var(--text);animation:fadeUp 400ms cubic-bezier(0.16,1,0.3,1) both;animation-delay:0s}
.hero .subtitle{animation:fadeUp 400ms cubic-bezier(0.16,1,0.3,1) both;animation-delay:.1s}
.hero .button{animation:fadeUp 400ms cubic-bezier(0.16,1,0.3,1) both;animation-delay:.2s}
.hero h1 em,.result-heading h1 em{color:var(--purple);font-style:normal}
.hero-copy>p{font-size:17px;color:var(--muted);max-width:500px;margin-bottom:24px}
.hero-button{width:min(340px,100%);justify-content:space-between;padding:16px 24px}
.trust-row{display:flex;gap:24px;color:var(--muted);font-size:13px;margin-top:16px}
.trust-row span:before{content:"✓";color:var(--purple);margin-right:8px}
.hero-visual{height:420px;position:relative;display:grid;place-items:center;perspective:900px}
@property --parallax-x{syntax:"<length>";inherits:false;initial-value:0px}
@property --parallax-y{syntax:"<length>";inherits:false;initial-value:0px}
.orbit{position:absolute;border:1px solid var(--line);border-radius:50%;transform:rotate(-18deg)}
.orbit-one{width:400px;height:220px}
.orbit-two{width:310px;height:420px;opacity:.4}
.orbit-dot{animation:slowSpin 20s linear infinite}
.demo-card{position:absolute;width:290px;height:180px;border-radius:16px;padding:24px;box-shadow:0 16px 48px #0001,0 4px 12px #0001;display:flex;flex-direction:column;justify-content:space-between;animation:float 4s cubic-bezier(0.25,0.1,0.25,1) infinite;transition:--parallax-x 300ms cubic-bezier(.16,1,.3,1),--parallax-y 300ms cubic-bezier(.16,1,.3,1)}
.card-back{--base:translate(55px,-65px) rotate(11deg);background:linear-gradient(145deg,#e8e6ff,#c7c3ff);transform:var(--base);color:#4a42c8;animation-delay:0s}
.card-back strong{font-size:38px}
.card-front{--base:translate(-25px,25px) rotate(-6deg);background:linear-gradient(145deg,#6c63ff,#4a3fd4);transform:var(--base);color:#fff;animation-delay:.5s}
.demo-top{display:flex;justify-content:space-between}
.chip,.mini-chip{width:32px;height:24px;border-radius:5px;background:linear-gradient(135deg,#f2d883,#b89234);display:inline-block}
.card-front small{display:block;letter-spacing:.15em;opacity:.7}
.card-front strong{font:700 28px var(--display);color:#a8ffdf}
.float-pill{position:absolute;background:#fff;border:1px solid var(--line);border-radius:10px;padding:8px 16px;font-weight:600;font-size:14px;box-shadow:0 4px 16px #0001;transform:translate(var(--parallax-x),var(--parallax-y));transition:--parallax-x 300ms cubic-bezier(.16,1,.3,1),--parallax-y 300ms cubic-bezier(.16,1,.3,1)}
.hero-visual.is-tracking-pointer .demo-card,.hero-visual.is-tracking-pointer .float-pill{transition:none}
.pill-top{right:5%;top:24%;color:var(--purple)}
.pill-bottom{left:3%;bottom:22%;color:var(--text)}

/* Stacks section */
.stacks-section{padding:40px 0 80px}
.section-heading{display:flex;align-items:end;justify-content:space-between;margin-bottom:24px}
.section-heading h2{font-size:32px;margin-top:8px}
.section-heading>p{color:var(--muted)}
.stack-row{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}
.stack-card{background:#fff;border:1px solid var(--line);padding:24px;border-radius:14px;position:relative;opacity:0;transform:translateY(20px);transition:opacity .5s cubic-bezier(.23,1,.32,1),transform .5s cubic-bezier(.23,1,.32,1),border-color 180ms cubic-bezier(.25,.1,.25,1),box-shadow 180ms cubic-bezier(.25,.1,.25,1)}
.stack-card.visible{opacity:1;transform:translateY(0)}
.stack-card:nth-child(2){transition-delay:.08s,.08s,0s,0s}
.stack-card:nth-child(3){transition-delay:.16s,.16s,0s,0s}
.stack-card:nth-child(4){transition-delay:.24s,.24s,0s,0s}
.stack-card:nth-child(5){transition-delay:.32s,.32s,0s,0s}
.stack-card:hover{transform:translateY(-3px);border-color:#c5c3d6;box-shadow:0 8px 24px #0001}
.stack-icon{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:#f0eeff;color:var(--purple);font-size:20px;margin-bottom:32px}
.card-count{position:absolute;right:14px;top:17px;font-size:11px;line-height:1.5;color:var(--muted);background:#f5f5f7;border-radius:99px;padding:8px}
.stack-card h3{font-size:18px}
.stack-card p{color:var(--muted);font-size:13px;min-height:60px}
.text-link{font-size:13px;font-weight:600}
.text-link b{color:var(--purple)}

/* Questionnaire */
.quiz-resume-banner{position:fixed;z-index:100;top:12px;left:50%;width:min(720px,calc(100% - 28px));display:flex;align-items:center;justify-content:space-between;gap:20px;padding:14px 16px 14px 20px;border:1px solid #ffffffaa;border-radius:14px;background:#ffffffc7;box-shadow:0 12px 36px #1a1a2e24;backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);transform:translate(-50%,0);opacity:1;transition:transform 220ms cubic-bezier(.23,1,.32,1),opacity 220ms cubic-bezier(.23,1,.32,1)}
@starting-style{.quiz-resume-banner{transform:translate(-50%,-120%);opacity:0}}
.quiz-resume-banner--leaving{transform:translate(-50%,-120%);opacity:0;pointer-events:none}
.quiz-resume-banner p{margin:0;font-size:14px}
.quiz-resume-actions{display:flex;align-items:center;gap:8px;flex-shrink:0}
.quiz-resume-actions button{border:0;border-radius:8px;padding:8px 12px;cursor:pointer;font-size:13px;font-weight:600;transition:background-color 180ms cubic-bezier(.23,1,.32,1),color 180ms cubic-bezier(.23,1,.32,1)}
.quiz-resume-continue{background:var(--purple);color:#fff}
.quiz-resume-fresh{background:#eeedf4;color:var(--muted)}
:root[data-theme="dark"] .quiz-resume-banner{border-color:#ffffff24;background:#1a1a2ed9;box-shadow:0 12px 36px #0006}
:root[data-theme="dark"] .quiz-resume-fresh{background:#303047;color:#c7c7d6}
@media(hover:hover) and (pointer:fine){.quiz-resume-continue:hover{background:#5b52f0}.quiz-resume-fresh:hover{background:#e2e1e9;color:var(--text)}}
@media(hover:hover) and (pointer:fine){:root[data-theme="dark"] .quiz-resume-fresh:hover{background:#3b3b55;color:#fff}}
@media(max-width:650px){.quiz-resume-banner{align-items:stretch;flex-direction:column;gap:10px}.quiz-resume-actions{display:grid;grid-template-columns:1fr 1fr}}
@media(prefers-reduced-motion:reduce){.quiz-resume-banner{transform:translate(-50%,0);transition:opacity 200ms cubic-bezier(.23,1,.32,1)}@starting-style{.quiz-resume-banner{transform:translate(-50%,0);opacity:0}}.quiz-resume-banner--leaving{transform:translate(-50%,0);opacity:0}}
.questionnaire{max-width:860px;padding:40px 0 80px}
.question-top{display:flex;justify-content:space-between;color:var(--muted);font-size:14px}
.quiet-button{border:0;background:none;color:var(--muted);cursor:pointer}
.progress{height:4px;background:#ebebef;border-radius:99px;margin:16px 0 56px;overflow:hidden}
.progress span{display:block;height:100%;background:var(--purple);transition:width .4s cubic-bezier(.16,1,.3,1)}
.question-step{opacity:0;transform:translateX(30px);transition:opacity .35s cubic-bezier(.16,1,.3,1),transform .35s cubic-bezier(.16,1,.3,1);pointer-events:none;position:absolute;width:100%;text-align:center}
.question-step.active{opacity:1;transform:translateX(0);pointer-events:auto;position:relative}
.question-step.exit-left{opacity:0;transform:translateX(-30px);transition-timing-function:cubic-bezier(0.5,0,0.75,0)}
.question-step h1{font-size:clamp(34px,4.5vw,52px);margin:16px 0}
.question-step>p{color:var(--muted);font-size:17px;margin:0 0 32px}
.choice-grid{display:grid;gap:14px}
.choice-grid.two{grid-template-columns:repeat(2,1fr)}
.choice-grid.three{grid-template-columns:repeat(3,1fr)}
.choice-card,.mini-choice,.line-choice{position:relative;background:#fff;border:1px solid var(--line);border-radius:14px;cursor:pointer;transition:border-color 180ms cubic-bezier(0.25,0.1,0.25,1),background-color 180ms cubic-bezier(0.25,0.1,0.25,1),box-shadow 180ms cubic-bezier(0.25,0.1,0.25,1);text-align:left}
.choice-card:hover,.mini-choice:hover,.line-choice:hover{border-color:#b8b5d0;box-shadow:0 4px 16px #6c63ff08}
.choice-card:has(input:checked),.mini-choice:has(input:checked),.line-choice:has(input:checked){border-color:var(--purple);background:#f8f7ff;box-shadow:0 0 0 2px #6c63ff22}
.choice-card input,.mini-choice input,.line-choice input{position:absolute;opacity:0}
.choice-card{padding:24px;min-height:210px;display:flex;flex-direction:column}
.choice-card:has(input:checked){animation:choice-bounce .2s cubic-bezier(.16,1,.3,1)}
.choice-emoji{width:44px;height:44px;border-radius:12px;background:#f0eeff;display:grid;place-items:center;color:var(--purple);font-size:20px;margin-bottom:24px}
.choice-card strong{font:700 22px var(--display);margin-bottom:8px}
.choice-card small,.line-choice small{color:var(--muted);font-size:14px}
.choice-card>b{font-size:13px;margin-top:auto;color:var(--purple)}
.mini-choice{padding:24px;font-weight:600;font-size:16px}
.choice-list{display:grid;gap:10px;max-width:620px;margin:auto}
.line-choice{display:flex;align-items:center;justify-content:space-between;padding:16px 24px}
.line-choice span{display:flex;flex-direction:column}
.choice-card.compact{min-height:180px}
.question-actions{display:flex;justify-content:space-between;margin-top:32px;position:relative}
.question-actions button{min-width:140px}
.question-actions button:disabled{opacity:.35}
.keyboard-hint{position:absolute;right:0;top:100%;margin:8px 0 0;color:var(--muted);font-size:12px;line-height:1.5;transition:opacity 250ms cubic-bezier(.25,.1,.25,1)}
.keyboard-hint.dismissed{opacity:0;pointer-events:none}
.key-flash{animation:key-flash 360ms cubic-bezier(.16,1,.3,1)!important}

/* Results */
.results{padding:48px 0 112px}
.result-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:40px}
.result-heading-actions{display:flex;gap:10px;align-items:center}
.share-stack[disabled]{cursor:wait;opacity:.7;transform:none;box-shadow:none}
.result-heading h1{font-size:46px;margin:16px 0 8px}
.result-heading p,.match-summary>p{color:var(--muted)}
.results-layout{display:grid;grid-template-columns:270px 1fr;gap:20px}
.match-summary{border:1px solid var(--line);background:#f9f9fb;border-radius:16px;padding:24px;opacity:0;animation:summaryEnter .5s cubic-bezier(.16,1,.3,1) 0s forwards}
.summary-icon{width:52px;height:52px;border-radius:14px;background:var(--purple);color:#fff;display:grid;place-items:center;font-size:24px;margin-bottom:24px}
.match-summary h2{font-size:26px;margin:8px 0}
.summary-stat{border-block:1px solid var(--line);padding:24px 0;margin:24px 0}
.summary-stat span{display:block;color:var(--muted);font-size:13px}
.summary-stat strong{display:block;color:var(--purple);font:700 36px var(--display)}
.summary-stat small{font:500 13px var(--body);color:var(--muted)}
.summary-meta{display:flex;justify-content:space-between;font-size:13px}
.summary-meta span{display:flex;flex-direction:column;color:var(--muted)}
.summary-meta b{color:var(--text);font-size:16px}
.savings-projection{border-top:1px solid var(--line);margin-top:22px;padding-top:20px}
.projection-heading{display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin-bottom:12px}.projection-heading h3{font-size:16px}.projection-heading output{color:var(--purple);font:700 15px var(--display)}
.savings-projection>label{display:block;color:var(--muted);font-size:12px;margin-bottom:8px}
.savings-projection input[type="range"]{width:100%;height:20px;margin:0;appearance:none;-webkit-appearance:none;background:transparent;cursor:pointer}
.savings-projection input[type="range"]::-webkit-slider-runnable-track{height:4px;border-radius:99px;background:linear-gradient(to right,var(--purple) 0 var(--slider-progress),#d9d9e1 var(--slider-progress) 100%)}
.savings-projection input[type="range"]::-moz-range-track{height:4px;border:0;border-radius:99px;background:linear-gradient(to right,var(--purple) 0 var(--slider-progress),#d9d9e1 var(--slider-progress) 100%)}
.savings-projection input[type="range"]::-webkit-slider-thumb{width:20px;height:20px;margin-top:-8px;border:2px solid #fff;border-radius:50%;appearance:none;-webkit-appearance:none;background:var(--purple);box-shadow:0 2px 7px #332b8855}
.savings-projection input[type="range"]::-moz-range-thumb{width:20px;height:20px;border:2px solid #fff;border-radius:50%;background:var(--purple);box-shadow:0 2px 7px #332b8855}
.projection-values{display:grid;gap:3px;margin-top:13px}.projection-values p{display:flex;justify-content:space-between;gap:8px;margin:0;color:var(--muted);font-size:11px}.projection-values strong{color:var(--text);font:700 12px var(--display);font-variant-numeric:tabular-nums}
.projection-chart{height:58px;display:flex;align-items:end;gap:8px;margin-top:14px;padding:7px 10px 0;border-bottom:1px solid var(--line);background:linear-gradient(to top,#6c63ff08,transparent);overflow:hidden}.projection-chart span{height:var(--bar-height);min-height:3px;flex:1;border-radius:5px 5px 0 0;background:linear-gradient(180deg,#918aff,var(--purple));transition:height 300ms cubic-bezier(.16,1,.3,1)}.projection-chart span:nth-child(2){background:linear-gradient(180deg,#45dec0,var(--mint))}.projection-chart span:nth-child(3){background:linear-gradient(180deg,#aaa7bd,#77738d)}
.fine-print{font-size:11px!important;color:var(--muted)}
.matched-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.results-skeletons{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;grid-column:1/-1}
.results-skeletons .skeleton-card{width:100%;max-width:280px}
.matched-cards:not(.is-loaded) .result-card{display:none}
.matched-cards.is-loaded .results-skeletons{display:none}
.result-card{border:1px solid var(--line);background:#fff;border-radius:16px;overflow:hidden;opacity:0;animation:cardEnter .5s cubic-bezier(.16,1,.3,1) forwards;transition:transform 180ms cubic-bezier(0.25,0.1,0.25,1),box-shadow 180ms cubic-bezier(0.25,0.1,0.25,1)}
.result-card:nth-child(1){animation-delay:.1s}
.result-card:nth-child(2){animation-delay:.2s}
.result-card:nth-child(3){animation-delay:.3s}
.result-card:hover{box-shadow:0 12px 32px #0002;transform:translateY(-3px)}
.card-visual{height:150px;margin:8px;border-radius:12px;padding:16px;display:flex;flex-direction:column;justify-content:space-between;box-shadow:0 8px 20px #0002;color:#fff}
.card-visual>div{display:flex;justify-content:space-between;font-size:11px}
.card-visual>strong{font:700 16px var(--display)}
.result-card,.explore-card,[data-dialog-content],.card-product-hero-inner,.similar-card{perspective:800px}
.card-visual,.explore-card-visual,.dialog-card-visual,.card-product-visual,.similar-card-visual{--tilt-x:0deg;--tilt-y:0deg;--highlight-x:50%;--highlight-y:50%;position:relative;overflow:hidden;transform:rotateX(var(--tilt-x)) rotateY(var(--tilt-y));transform-style:preserve-3d;transition:transform 400ms cubic-bezier(.16,1,.3,1),box-shadow 400ms cubic-bezier(.16,1,.3,1);will-change:transform}
.card-visual.is-tilting,.explore-card-visual.is-tilting,.dialog-card-visual.is-tilting,.card-product-visual.is-tilting,.similar-card-visual.is-tilting{transition-duration:80ms;box-shadow:0 12px 28px #0003}
.card-visual::before,.explore-card-visual::before,.dialog-card-visual::before,.card-product-visual::before,.similar-card-visual::before{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:radial-gradient(circle at var(--highlight-x) var(--highlight-y),rgba(255,255,255,.06) 0,rgba(255,255,255,0) 55%)}
.card-visual>*,.explore-card-visual>*,.dialog-card-visual>*,.card-product-visual>*,.similar-card-visual>*{position:relative;z-index:2}
.tone-1{background:linear-gradient(145deg,#6c63ff,#4a3fd4)}
.tone-2{background:linear-gradient(145deg,#16b89a,#0a7a65)}
.tone-3{background:linear-gradient(145deg,#8b87a5,#5a576e)}
.tone-4{background:linear-gradient(145deg,#e85d75,#b8344d)}
.tone-5{background:linear-gradient(145deg,#f0a030,#c07818)}
.tone-6{background:linear-gradient(145deg,#3498db,#2176ad)}
.mini-chip{width:24px;height:18px}
.card-body{padding:16px}
.card-role{color:var(--purple);font-size:10px;font-weight:700;letter-spacing:.13em}
.card-match-reasons{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px}
.card-match-reasons:empty{display:none}
.card-match-reasons span{background:#e9fbf6;color:#087962;font-size:11px;line-height:1.5;border-radius:99px;padding:4px 10px;font-weight:600}
.card-body h3{font-size:18px;margin:8px 0}
.card-name-link{color:inherit;text-decoration:none}.card-name-link:hover{color:var(--purple)}
.card-body>p{font-size:13px;color:var(--muted);min-height:52px}
.tags{display:flex;flex-wrap:wrap;gap:5px;min-height:52px}
.tags span{font-size:10px;padding:8px;border:1px solid var(--line);border-radius:99px;color:var(--muted)}
.reward-line{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding:16px 0;margin-top:16px;font-size:12px}
.reward-line span{color:var(--muted)}
.reward-line strong{color:var(--purple)}
.card-actions{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.card-actions .button{padding:8px;font-size:13px}
.keep-card.kept{background:var(--purple);color:#fff}
.pulse-kept{animation:pulse 300ms cubic-bezier(0.34,1.56,0.64,1)}

/* Results footer */
.results-footer{position:fixed;bottom:0;left:0;right:0;height:72px;background:#ffffffee;backdrop-filter:blur(12px);border-top:1px solid var(--line);display:flex;justify-content:flex-end;align-items:center;gap:24px;padding:0 max(24px,calc((100vw - 1180px)/2));z-index:20}
.results-footer p{color:var(--muted);font-size:14px}

/* Wallet */
.wallet-page{padding:32px 0 40px}
.wallet-header{margin-bottom:16px}
.wallet-header h1{font-size:34px;margin:8px 0}
.wallet-subtitle{color:var(--muted);font-size:14px}
.wallet-priority-help{margin:4px 0 0;color:var(--muted);font-size:11px;line-height:1.5}

.wallet-nav-links{display:flex;gap:10px;margin-top:24px}

/* Layout: card spread left, detail panel (card backside) right */
.wallet-layout{display:grid;grid-template-columns:1fr 480px;gap:28px;align-items:start;min-height:360px;perspective:1600px}

/* Detail panel — reads as the flipped-over backside of the selected card */
.wallet-detail-panel{order:2;position:relative;background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden;transform-style:preserve-3d;transform-origin:left center;animation:cardFlipIn 500ms cubic-bezier(0.16,1,0.3,1)}
.wallet-detail-panel[hidden]{display:none}
@keyframes cardFlipIn{0%{opacity:0;transform:rotateY(-115deg) scale(.92)}60%{opacity:1}100%{opacity:1;transform:rotateY(0deg) scale(1)}}

.detail-close{position:absolute;top:10px;right:10px;width:26px;height:26px;border-radius:50%;border:0;background:#00000030;color:#fff;font-size:13px;line-height:1;cursor:pointer;display:grid;place-items:center;z-index:5;transition:transform 180ms cubic-bezier(0.25,0.1,0.25,1),background-color 180ms cubic-bezier(0.25,0.1,0.25,1)}
.detail-close:hover{background:#00000055;transform:scale(1.08)}

.card-detail-top{padding:0}
.card-detail-visual{height:120px;border-radius:18px 18px 0 0;padding:16px 24px;display:flex;flex-direction:column;justify-content:space-between;color:#fff}
.card-detail-visual>div{display:flex;justify-content:space-between;font-size:12px;align-items:center;padding-right:32px}
.card-detail-visual>strong{font:700 19px var(--display)}
.card-detail-visual .detail-dots{font-size:13px;letter-spacing:2px;opacity:.7}

.card-detail-body{padding:16px 24px}
.card-detail-section{margin-bottom:16px}
.card-detail-section h3{font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin-bottom:8px}

.detail-rewards{display:grid;grid-template-columns:repeat(6,1fr);gap:5px}
.reward-pill{background:#f5f5f7;border-radius:9px;padding:8px;text-align:center}
.reward-pill .rp-cat{font-size:8.5px;line-height:1.5;color:var(--muted);display:block;margin-bottom:8px;text-transform:capitalize;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.reward-pill .rp-val{font:700 14px var(--display);color:var(--purple)}

.detail-meta{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.meta-item{background:#f9f9fb;border-radius:9px;padding:8px}
.meta-item span{font-size:9px;line-height:1.5;color:var(--muted);display:block;margin-bottom:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.meta-item b{font-size:12px;color:var(--text)}

.detail-perks{display:flex;flex-wrap:wrap;gap:5px}
.perk-tag{font-size:11px;padding:8px;border:1px solid var(--line);border-radius:99px;color:var(--muted);background:#fff}

.detail-partners{display:flex;flex-wrap:wrap;gap:5px}
.partner-tag{font-size:11px;padding:8px;border-radius:99px;background:#e8e6ff;color:var(--purple);font-weight:600}

.detail-bonus{background:#f9f9fb;border-radius:12px;padding:16px}
.detail-bonus .bonus-amount{font:700 20px var(--display);color:var(--purple);display:block;margin-bottom:8px}
.detail-bonus .bonus-spend{font-size:12px;color:var(--muted)}

.card-detail-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}
.card-signup-btn{text-align:center;font-size:13px;padding:8px}
.card-remove-btn{text-align:center;font-size:13px;padding:8px;color:var(--muted)!important;border-color:var(--line)!important}
.card-remove-btn:hover{color:#e74c3c!important;border-color:#e74c3c!important}

/* Card spread (left side) */
.wallet-spread{order:1;position:relative;height:360px;max-width:660px}
.wallet-skeletons .skeleton-card{width:min(280px,80%);height:210px;position:absolute;left:50%;transform:translateX(-50%)}
.wallet-skeletons .skeleton-card:nth-child(2){transform:translateX(-50%) rotate(-5deg)}
.wallet-skeletons .skeleton-card:nth-child(3){transform:translateX(-50%) rotate(5deg)}
.spread-card{position:absolute;left:50%;width:min(340px,80%);height:210px;border-radius:18px;padding:24px;display:flex;flex-direction:column;justify-content:space-between;color:#fff;cursor:pointer;transition:transform 500ms cubic-bezier(0.16,1,0.3,1),opacity 300ms cubic-bezier(0.16,1,0.3,1),box-shadow 180ms cubic-bezier(0.25,0.1,0.25,1),filter 180ms cubic-bezier(0.25,0.1,0.25,1);transform-origin:center bottom;box-shadow:0 6px 20px #0002;z-index:var(--z)}
.spread-card>div{display:flex;justify-content:space-between;font-size:11px;align-items:center}
.spread-card>strong{font:700 18px var(--display)}
.spread-card .spread-dots{font-size:13px;letter-spacing:2px;opacity:.7}
.spread-card:hover{filter:brightness(1.05)}
.spread-card:active{transition:transform 300ms cubic-bezier(0.34,1.56,0.64,1),opacity 300ms cubic-bezier(0.34,1.56,0.64,1),box-shadow 300ms cubic-bezier(0.34,1.56,0.64,1),filter 300ms cubic-bezier(0.34,1.56,0.64,1)}
.card-reorder-controls{position:absolute!important;top:10px;right:10px;z-index:4;display:flex!important;gap:5px;opacity:0;transform:translateY(-3px);transition:opacity 160ms ease,transform 160ms ease}
.spread-card:hover .card-reorder-controls,.spread-card:focus-within .card-reorder-controls{opacity:1;transform:translateY(0)}
.card-reorder-button{width:24px;height:24px;padding:0;border:1px solid #ffffff66;border-radius:50%;background:transparent;color:#fff;display:grid;place-items:center;font-size:14px;line-height:1;cursor:pointer;transition:background-color 160ms ease,border-color 160ms ease,opacity 160ms ease,transform 160ms ease}
.card-reorder-button:hover:not(:disabled){background:#ffffff24;border-color:#ffffffaa;transform:scale(1.08)}
.card-reorder-button:disabled{opacity:.35;cursor:not-allowed}
@media(hover:none){.card-reorder-controls{opacity:1;transform:none}}

/* Wallet empty */
.wallet-empty{text-align:center;padding:80px 24px}
.wallet-empty-inner{max-width:360px;margin:0 auto}
.wallet-empty-icon{font-size:48px;display:block;margin-bottom:16px}
.wallet-empty-inner h2{font-size:24px;margin-bottom:8px}
.wallet-empty-inner p{color:var(--muted);margin-bottom:24px}

.bottom-nav{display:none}

/* Explore */
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.explore-page{min-height:100vh;background:#fafafd;padding-bottom:80px}
.explore-heading{padding:52px 0 30px}
.explore-heading h1{font-size:clamp(38px,5vw,56px);margin:10px 0}
.explore-heading p{color:var(--muted);margin:0}
.explore-toolbar{position:sticky;top:0;z-index:15;background:#fafafded;border-block:1px solid var(--line);backdrop-filter:blur(18px)}
.explore-toolbar-inner{display:grid;grid-template-columns:minmax(230px,1fr) auto;gap:12px 20px;padding-block:14px}
.explore-search{height:44px;display:flex;align-items:center;gap:10px;background:#fff;border:1px solid var(--line);border-radius:11px;padding:0 14px;color:var(--muted)}
.explore-search:focus-within{border-color:var(--purple);box-shadow:0 0 0 3px #6c63ff16}
.explore-search input{width:100%;border:0;outline:0;background:transparent;color:var(--text)}
.filter-chips{grid-column:1/-1;display:flex;gap:8px;overflow-x:auto;padding-bottom:2px;scrollbar-width:none}
.filter-chip{white-space:nowrap;border:1px solid var(--line);background:#fff;border-radius:99px;padding:8px 13px;color:var(--muted);font-size:13px;cursor:pointer;transition:all 160ms ease}
.filter-chip:hover{border-color:#b8b5d0;color:var(--text)}
.filter-chip[aria-pressed="true"]{background:#eeecff;border-color:#b9b4ff;color:#5148dd;font-weight:600}
.explore-sort{height:44px;display:flex;align-items:center;gap:8px;background:#fff;border:1px solid var(--line);border-radius:11px;padding:0 12px;color:var(--muted);font-size:12px}
.explore-sort select{border:0;outline:0;background:transparent;color:var(--text);font:600 13px var(--body)}
.explore-results{padding-top:24px}
.explore-count{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;font-size:14px}
.explore-count button{border:0;background:none;color:var(--purple);cursor:pointer;font-weight:600}
.explore-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.explore-card{position:relative;min-height:303px;background:#fff;border:1px solid var(--line);border-radius:15px;cursor:pointer;opacity:0;perspective:1000px;animation:exploreCardIn 420ms cubic-bezier(.16,1,.3,1) var(--card-delay) forwards;transition:transform 180ms ease,box-shadow 180ms ease,border-color 180ms ease}
.explore-card:hover,.explore-card:focus-visible{transform:translateY(-3px);box-shadow:0 12px 30px #24203d16;border-color:#cbc8dd;outline:0}
.explore-card-inner{display:grid;height:100%;transform-style:preserve-3d;transition:transform 500ms cubic-bezier(.4,0,.2,1)}
.explore-card.is-flipped .explore-card-inner{transform:rotateY(180deg)}
.explore-card-face{grid-area:1/1;min-width:0;overflow:hidden;border-radius:14px;backface-visibility:hidden;-webkit-backface-visibility:hidden}
.explore-card-front{background:#fff}
.explore-card-back{display:flex;flex-direction:column;gap:15px;padding:20px 17px 16px;background:linear-gradient(145deg,#2d2960,#1a1640);color:#fff;transform:rotateY(180deg)}
.explore-card-back h2{padding-right:27px;font-size:17px}.explore-back-kicker{margin:0 0 4px;color:#bdb8ff;font-size:9px;font-weight:700;letter-spacing:.12em}.explore-reward-bars{display:grid;gap:10px}.explore-reward-row{display:grid;grid-template-columns:1fr auto;gap:3px 8px;font-size:11px;text-transform:capitalize}.explore-reward-row b{color:#c9ffed}.explore-reward-row i{grid-column:1/-1;height:5px;overflow:hidden;border-radius:99px;background:#ffffff25}.explore-reward-row i span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#8d85ff,#57e2bd)}
.explore-back-stats{display:grid;grid-template-columns:auto 1fr;gap:12px;margin-top:auto}.explore-back-stats>span{display:flex;flex-direction:column;color:#c3c0d6;font-size:9px}.explore-back-stats b{color:#fff;font-size:12px}.explore-back-add{background:#fff;color:#2d2960}.explore-back-add:hover{background:#f0efff}
.explore-flip-button{position:absolute;z-index:4;top:12px;right:12px;width:28px;height:28px;padding:0;border:0;border-radius:50%;display:grid;place-items:center;background:#ffffffc7;color:#29254f;box-shadow:0 2px 8px #0002;cursor:pointer;font-weight:700;line-height:1;transition:background-color 160ms ease,transform 160ms ease}.explore-flip-button:hover{background:#fff;transform:scale(1.06)}.explore-flip-button:focus-visible{outline:2px solid #fff;outline-offset:2px}
.explore-card-visual{height:105px;margin:7px;border-radius:10px;padding:13px;color:#fff;display:grid;grid-template-columns:1fr auto;grid-template-rows:auto 1fr auto;align-items:start;box-shadow:0 7px 18px #0002}
.explore-card-visual>.mini-chip{grid-column:1}.explore-card-visual>b{font-size:10px}.explore-card-visual>strong{grid-column:1/-1;align-self:end;font:700 14px var(--display)}.explore-card-visual>small{grid-column:2;grid-row:3;font-size:9px;opacity:.75}
.tone-4{background:linear-gradient(145deg,#e85d75,#ad2f4c)}.tone-5{background:linear-gradient(145deg,#eea23b,#b96d12)}.tone-6{background:linear-gradient(145deg,#3498db,#205da5)}
.explore-card-body{padding:13px 15px 15px}.explore-issuer{font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:var(--purple);font-weight:700;margin:0 0 5px}.explore-card-body h2{font-size:17px;min-height:38px}
.explore-card-meta{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:14px 0}.explore-card-meta span{font-size:10px;color:var(--muted);display:flex;flex-direction:column}.explore-card-meta b{font-size:15px;color:var(--text)}
.explore-add{width:100%;padding:9px;font-size:12px}.explore-add.saved{background:#e9fbf6;color:#087962}.explore-add.saved:hover{background:#d9f7ee;box-shadow:none}
.explore-empty{text-align:center;padding:70px 20px;color:var(--muted)}.explore-empty span{font-size:42px}.explore-empty h2{color:var(--text);margin-top:10px}
@keyframes exploreCardIn{from{opacity:0;transform:translateY(15px) scale(.98)}to{opacity:1;transform:translateY(0) scale(1)}}
.card-dialog{width:min(560px,calc(100% - 28px));padding:0;border:0;border-radius:18px;box-shadow:0 24px 80px #0004;overflow:hidden}.card-dialog::backdrop{background:#17142488;backdrop-filter:blur(4px)}.dialog-close{position:absolute;right:12px;top:12px;z-index:2;width:32px;height:32px;border:0;border-radius:50%;background:#fff;color:var(--text);cursor:pointer;font-size:20px}.dialog-card-visual{height:190px;color:#fff;padding:25px;display:flex;flex-direction:column;justify-content:space-between}.dialog-card-visual strong{font:700 24px var(--display)}.dialog-body{padding:25px}.dialog-body h2{font-size:28px;margin:7px 0}.dialog-body>p{color:var(--muted);margin-top:0}.dialog-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:20px 0}.dialog-stats div{background:#f6f6f9;padding:12px;border-radius:10px}.dialog-stats span{display:block;color:var(--muted);font-size:10px}.dialog-stats strong{font-size:14px}.dialog-rewards{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:20px}.dialog-rewards span{background:#f0eeff;color:#5a52d7;border-radius:99px;padding:7px 10px;font-size:11px}.dialog-wallet-button{width:100%}

/* Keyboard shortcuts */
.shortcuts-dialog{width:min(480px,calc(100% - 28px));max-height:calc(100vh - 40px);padding:0;border:1px solid var(--line);border-radius:18px;background:var(--panel);color:var(--text);box-shadow:0 24px 80px #0005;overflow:hidden}.shortcuts-dialog::backdrop{background:#17142488;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}.shortcuts-header{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:24px;border-bottom:1px solid var(--line)}.shortcuts-header h2{font-size:26px;margin-top:5px}.shortcuts-close{width:34px;height:34px;flex:0 0 auto;border:1px solid var(--line);border-radius:50%;background:var(--panel);color:var(--text);cursor:pointer;font-size:22px;line-height:1}.shortcuts-groups{padding:8px 24px 20px;overflow:auto}.shortcuts-groups section{padding-top:16px}.shortcuts-groups section+section{margin-top:10px;border-top:1px solid var(--line)}.shortcuts-groups h3{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:7px}.shortcut-row{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:42px;font-size:14px}.shortcut-row kbd{min-width:30px;padding:3px 8px;border:1px solid #c9c9d2;border-radius:6px;background:#f7f7f9;color:var(--text);box-shadow:0 2px 0 #c9c9d2;font:600 12px/1.5 ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;text-align:center}

/* Card product page */
:root[data-theme="dark"] .shortcut-row kbd{background:#25253d;border-color:#45455d;box-shadow:0 2px 0 #45455d}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]) .shortcut-row kbd{background:#25253d;border-color:#45455d;box-shadow:0 2px 0 #45455d}}

.card-product{padding-bottom:96px}
.card-product-hero{border-bottom:1px solid var(--line);overflow:hidden;position:relative}
.tone-bg-1{background:linear-gradient(135deg,#f0efff,#fafaff 62%)}.tone-bg-2{background:linear-gradient(135deg,#e5faf6,#fbfffe 62%)}.tone-bg-3{background:linear-gradient(135deg,#efeff4,#fbfbfd 62%)}.tone-bg-4{background:linear-gradient(135deg,#fff0f3,#fffafa 62%)}.tone-bg-5{background:linear-gradient(135deg,#fff5e5,#fffdf9 62%)}.tone-bg-6{background:linear-gradient(135deg,#eaf6fd,#fbfdff 62%)}
.card-product-hero-inner{min-height:500px;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;position:relative;padding-top:70px;padding-bottom:70px}
.card-product-back{position:absolute;top:28px;left:0;color:var(--muted);font-size:13px;font-weight:600}
.card-product-visual{justify-self:center;width:min(460px,100%);aspect-ratio:1.58;border-radius:24px;padding:32px;color:#fff;display:flex;flex-direction:column;justify-content:space-between;box-shadow:0 28px 60px #26223d33}
.card-product-visual>div{display:flex;align-items:center;justify-content:space-between;font-size:14px}.card-product-visual>strong{font:700 clamp(24px,3vw,36px) var(--display)}.card-product-visual>span:last-child{letter-spacing:.18em;opacity:.7}
.card-product-intro h1{font-size:clamp(44px,5vw,68px);line-height:1;margin:18px 0 12px}.card-product-intro>p{font-size:17px;color:var(--muted);margin-bottom:28px}.card-wallet-button.kept{background:#171624;color:#fff}
.card-product-content{max-width:1080px;padding-top:72px}.product-section{padding:48px 0;border-bottom:1px solid var(--line)}.product-section h2,.product-bonus h2{font-size:32px;margin:10px 0 24px}.why-card{padding-top:0}.why-card>p{font:500 clamp(22px,2.5vw,30px)/1.5 var(--display);max-width:920px;color:#343240}
.product-two-column{display:grid;grid-template-columns:1.15fr .85fr;gap:72px}.product-two-column .product-section{border-bottom:0}
.product-rewards{display:grid;gap:18px}.product-reward-label{display:flex;align-items:baseline;gap:8px;margin-bottom:8px;text-transform:capitalize}.product-reward-label strong{font:700 18px var(--display);color:var(--purple)}.product-reward-label span{color:var(--muted);font-size:13px}.product-reward-track{height:9px;background:#eeeef3;border-radius:99px;overflow:hidden}.product-reward-track span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--purple),#9b94ff);transform-origin:left center}.card-product.detail-animation-ready .product-reward-track span{transform:scaleX(0)}.card-product.detail-animation-played .product-reward-track span{transform:scaleX(1);transition:transform 600ms cubic-bezier(.16,1,.3,1) var(--reward-delay)}
.product-detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.product-detail-grid>div{background:#f7f7fa;border:1px solid #eeeef2;border-radius:14px;padding:20px;min-height:105px}.product-detail-grid span{display:block;color:var(--muted);font-size:11px;margin-bottom:16px}.product-detail-grid strong{font:700 17px var(--display)}
.product-tags{display:flex;flex-wrap:wrap;gap:10px}.product-tags span{padding:11px 15px;border-radius:99px;border:1px solid var(--line);background:#fff;font-size:13px}.product-partners .product-tags span{background:#f0eeff;border-color:#dedaff;color:var(--purple);font-weight:600}
.product-bonus{margin:64px 0 16px;padding:36px 40px;border-radius:22px;color:#fff;background:linear-gradient(135deg,#282443,#171624);display:flex;align-items:center;justify-content:space-between;gap:40px;box-shadow:0 18px 40px #17162420}.product-bonus .kicker{color:#aaa4ff}.product-bonus h2{margin-bottom:0}.product-bonus p{max-width:360px;color:#d6d4df;line-height:1.7}
.similar-section{border-bottom:0}.similar-card-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.similar-card{display:block;border:1px solid var(--line);border-radius:16px;background:#fff;padding:8px;color:var(--text);transition:transform 180ms ease,box-shadow 180ms ease}.similar-card:hover{transform:translateY(-4px);box-shadow:0 14px 30px #00000014}.similar-card-visual{height:128px;border-radius:11px;padding:16px;color:#fff;display:flex;flex-direction:column;justify-content:space-between}.similar-card-visual span,.similar-card-visual small{font-size:10px;opacity:.8}.similar-card-visual strong{font:700 16px var(--display)}.similar-card>div:last-child{padding:14px 8px 10px;display:flex;flex-direction:column;gap:7px}.similar-card>div:last-child>span{color:var(--muted);font-size:11px}
.wallet-card-name-link{color:inherit;text-decoration:none}.wallet-card-name-link:hover{text-decoration:underline;text-underline-offset:3px}

/* Animations */
main.page-exit{opacity:0;transform:translateY(-8px);transition:opacity 150ms ease,transform 150ms ease;pointer-events:none}
main.page-enter{animation:pageEnter 300ms cubic-bezier(.16,1,.3,1) both}
@keyframes pageEnter{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
@keyframes fade{from{opacity:0;transform:translateY(6px)}}
@keyframes float{0%,100%{transform:var(--base) translate(var(--parallax-x),var(--parallax-y)) translateY(0)}50%{transform:var(--base) translate(var(--parallax-x),var(--parallax-y)) translateY(-8px)}}
@keyframes slowSpin{to{transform:rotate(360deg)}}
@keyframes shake{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
@keyframes choice-bounce{50%{transform:scale(.97)}100%{transform:scale(1)}}
@keyframes key-flash{0%{outline:0 solid #6c63ff00;outline-offset:0;transform:scale(1)}45%{outline:4px solid #6c63ff55;outline-offset:3px;transform:scale(1.025)}100%{outline:0 solid #6c63ff00;outline-offset:7px;transform:scale(1)}}
@media(prefers-reduced-motion:reduce){.question-step{transform:none;transition:opacity 200ms cubic-bezier(0.25,0.1,0.25,1)}.question-step.exit-left{transform:none}.choice-card:has(input:checked){animation:none}.progress span{transition-duration:200ms}.card-visual,.explore-card-visual,.dialog-card-visual,.card-product-visual,.similar-card-visual{transform:none;transition:none;will-change:auto}.card-visual::before,.explore-card-visual::before,.dialog-card-visual::before,.card-product-visual::before,.similar-card-visual::before{display:none}.explore-card-inner{transition:none}.explore-card.is-flipped .explore-card-inner{transform:none}.explore-card.is-flipped .explore-card-front{visibility:hidden}.explore-card:not(.is-flipped) .explore-card-back{visibility:hidden}}
@keyframes cardEnter{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
@keyframes summaryEnter{from{opacity:0;transform:translateX(-24px)}to{opacity:1;transform:translateX(0)}}
@keyframes pulse{50%{transform:scale(1.15)}}
@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.hero h1,.result-heading h1,.wallet-header h1{animation:fadeUp 400ms cubic-bezier(0.16,1,0.3,1) both}

@media(prefers-reduced-motion:reduce){.result-card,.match-summary{opacity:1;transform:none;animation:none}.pulse-kept{animation:none}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.demo-card,.orbit-dot{animation:none}.demo-card,.float-pill{--parallax-x:0px!important;--parallax-y:0px!important;transition:none}.hero h1,.hero .subtitle,.hero .button{animation:fadeUp 200ms cubic-bezier(0.16,1,0.3,1) both}.stack-card{transform:none;transition:opacity 200ms cubic-bezier(0.25,0.1,0.25,1)}}
@media(hover:none){.demo-card,.float-pill{--parallax-x:0px!important;--parallax-y:0px!important;transition:none}}

/* Responsive */
@media(max-width:980px){.desktop-links{display:none}.hero{grid-template-columns:1fr}.stack-row{display:flex;overflow-x:auto}.stack-card{min-width:230px}.results-layout{grid-template-columns:1fr}.matched-cards{grid-template-columns:repeat(3,minmax(230px,1fr));overflow-x:auto}.wallet-layout{grid-template-columns:1fr}.wallet-detail-panel{border-radius:16px}.explore-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:650px){.shell{width:calc(100% - 28px)}.site-nav{height:60px;padding:0 16px}.button-small{display:none}.hero{padding-top:24px}.hero h1{font-size:40px}.hero-visual{height:300px}.demo-card{width:220px;height:140px;padding:16px}.card-back{transform:translate(32px,-50px) rotate(11deg)}.card-front{transform:translate(-18px,20px) rotate(-6deg)}.orbit-one{width:280px;height:160px}.orbit-two{width:230px;height:300px}.section-heading{display:block}.stack-card{min-width:230px}.questionnaire{padding-top:24px}.progress{margin-bottom:40px}.question-step h1{font-size:34px}.choice-grid.two,.choice-grid.three{grid-template-columns:1fr}.choice-card{min-height:150px}.result-heading{display:block}.result-heading h1{font-size:36px}.result-heading-actions{margin-top:24px;flex-wrap:wrap}.result-heading-actions .button{flex:1;white-space:nowrap;padding-inline:16px}.matched-cards{grid-template-columns:repeat(3,82vw)}.results-footer{justify-content:space-between;padding:0 16px}.bottom-nav{position:fixed;display:flex;z-index:30;bottom:0;left:0;right:0;background:#fffffff5;border-top:1px solid var(--line);height:72px;align-items:center;justify-content:space-around}.bottom-nav a{display:flex;flex-direction:column;align-items:center;font-size:11px;color:var(--muted)}.bottom-nav .active{color:var(--purple)}.wallet-page{padding-bottom:120px}.wallet-layout{grid-template-columns:1fr}.wallet-nav-links{flex-direction:column}.wallet-nav-links .button{text-align:center}.spread-card{width:min(300px,85%)!important}.card-reorder-controls{opacity:1;transform:none}.detail-rewards{grid-template-columns:repeat(3,1fr)}.detail-meta{grid-template-columns:repeat(2,1fr)}.card-detail-actions{grid-template-columns:1fr}}

@media(max-width:650px){.card-back{--base:translate(32px,-50px) rotate(11deg)}.card-front{--base:translate(-18px,20px) rotate(-6deg)}}
@media(max-width:650px){.explore-heading{padding:32px 0 22px}.explore-toolbar{top:0}.explore-toolbar-inner{grid-template-columns:1fr}.explore-sort{grid-row:2}.filter-chips{grid-row:3}.explore-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.explore-card-body{padding:11px}.explore-card-body h2{font-size:15px}.explore-card-meta{grid-template-columns:1fr}.dialog-stats{grid-template-columns:1fr}.card-dialog{max-height:90vh;overflow:auto}}

@media(max-width:800px){.card-product-hero-inner{grid-template-columns:1fr;gap:42px;padding-top:76px}.card-product-visual{width:min(420px,92%)}.card-product-intro{text-align:center}.product-two-column{grid-template-columns:1fr;gap:0}.similar-card-grid{grid-template-columns:1fr}.product-bonus{align-items:flex-start;flex-direction:column}.card-product-back{left:14px}}
@media(max-width:650px){.card-product-hero-inner{min-height:auto;padding-bottom:48px}.card-product-visual{padding:22px;border-radius:18px}.card-product-content{padding-top:48px}.product-section{padding:36px 0}.why-card>p{font-size:21px}.product-detail-grid{grid-template-columns:1fr}.product-bonus{margin-top:40px;padding:28px 24px}.product-section h2,.product-bonus h2{font-size:27px}}

/* Chat widget */
.toast-container{position:fixed;right:24px;bottom:96px;z-index:60;display:flex;flex-direction:column-reverse;gap:8px;align-items:flex-end;pointer-events:none}
.toast{position:relative;max-width:320px;overflow:hidden;display:flex;align-items:center;gap:10px;padding:12px 16px;background:#fff;border:1px solid var(--line);border-left-width:4px;border-radius:12px;box-shadow:0 10px 30px #0002;color:var(--text);font-size:14px;line-height:1.5;cursor:pointer;pointer-events:auto;opacity:1;transform:translateX(0);transition:transform .3s cubic-bezier(.16,1,.3,1),opacity .3s cubic-bezier(.16,1,.3,1)}
.toast-entering{opacity:0;transform:translateX(calc(100% + 24px))}
.toast-exiting{opacity:0;transform:translateX(calc(100% + 24px));transition-duration:.2s;transition-timing-function:ease-in}
.toast-success{border-left-color:#22a06b}.toast-info{border-left-color:var(--purple)}.toast-warning{border-left-color:#e58a17}
.toast-message{min-width:0}
.toast-progress{position:absolute;right:0;bottom:0;left:0;height:2px;background:currentColor;opacity:.18;transform:scaleX(1);transform-origin:left;animation:toast-countdown var(--toast-duration) linear forwards}
.toast-exiting .toast-progress{animation-play-state:paused}
@keyframes toast-countdown{to{transform:scaleX(0)}}

.chat-widget{position:fixed;bottom:24px;right:24px;z-index:50;font-family:var(--body)}
.chat-toggle{width:56px;height:56px;border-radius:50%;background:var(--purple);color:#fff;border:0;cursor:pointer;display:grid;place-items:center;box-shadow:0 4px 20px #6c63ff44;transition:transform 180ms cubic-bezier(0.25,0.1,0.25,1),box-shadow 180ms cubic-bezier(0.25,0.1,0.25,1);font-size:24px}
.chat-toggle:hover{transform:scale(1.08);box-shadow:0 6px 28px #6c63ff55}
.chat-panel{position:absolute;bottom:72px;right:0;width:380px;max-height:520px;background:#fff;border:1px solid var(--line);border-radius:16px;box-shadow:0 12px 40px #0002;display:flex;flex-direction:column;overflow:hidden}
.chat-panel.is-waiting{animation:chatBorderPulse 1.5s ease-in-out infinite}
@keyframes chatBorderPulse{0%,100%{border-color:var(--line);box-shadow:0 12px 40px #0002}50%{border-color:#6c63ff99;box-shadow:0 12px 40px #6c63ff22,0 0 0 2px #6c63ff18}}
.chat-panel[hidden]{display:none}
.chat-header{display:flex;align-items:center;justify-content:space-between;padding:16px;border-bottom:1px solid var(--line);background:#f9f9fb}
.chat-header-info{display:flex;align-items:center;gap:10px}
.chat-avatar{width:34px;height:34px;border-radius:10px;background:var(--purple);color:#fff;display:grid;place-items:center;font-weight:700;font-size:14px}
.chat-header strong{font-size:14px;display:block}
.chat-header small{font-size:11px;color:var(--muted)}
.chat-close{border:0;background:none;font-size:18px;color:var(--muted);cursor:pointer;padding:8px}
.chat-messages{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px;min-height:300px;max-height:380px}
.chat-msg{display:flex;gap:8px;align-items:flex-start}
.chat-msg-bot{flex-direction:row}
.chat-msg-user{flex-direction:row-reverse}
.chat-msg-avatar{width:28px;height:28px;border-radius:8px;background:var(--purple);color:#fff;display:grid;place-items:center;font-size:11px;font-weight:700;flex-shrink:0}
.chat-msg-user .chat-msg-avatar{background:#e8e6ff;color:var(--purple)}
.chat-msg-bubble{max-width:75%;padding:8px 16px;border-radius:12px;font-size:14px;line-height:1.5}
.chat-msg-bot .chat-msg-bubble{background:#f5f5f7;color:var(--text)}
.chat-msg-user .chat-msg-bubble{background:var(--purple);color:#fff}
.chat-msg-bubble p{margin:0 0 8px}
.chat-msg-bubble p:last-child{margin:0}
.chat-typing{display:flex;gap:4px;padding:8px 16px}
.chat-typing span{width:6px;height:6px;background:#b0b0be;border-radius:50%;animation:typingDot 1.2s infinite}
.chat-typing span:nth-child(2){animation-delay:.2s}
.chat-typing span:nth-child(3){animation-delay:.4s}
@keyframes typingDot{0%,60%,100%{opacity:.3;transform:scale(1)}30%{opacity:1;transform:scale(1.2)}}
.chat-input-row{display:flex;gap:8px;padding:16px;border-top:1px solid var(--line);background:#fff}
.chat-input{flex:1;border:1px solid var(--line);border-radius:10px;padding:8px 16px;font-size:14px;outline:none;transition:border-color 180ms cubic-bezier(0.25,0.1,0.25,1)}
.chat-input:focus{border-color:var(--purple)}
.chat-send{width:40px;height:40px;border:0;border-radius:10px;background:var(--purple);color:#fff;font-size:18px;cursor:pointer;display:grid;place-items:center;transition:background-color 180ms cubic-bezier(0.25,0.1,0.25,1)}
.chat-send:hover{background:#5b52f0}
@media(max-width:650px){.toast-container{right:14px;bottom:160px;left:14px}.toast{max-width:min(320px,100%)}.chat-widget{bottom:90px;right:14px}.chat-panel{width:calc(100vw - 28px);right:-10px;max-height:70vh}}

small,.avatar,.button-small,.trust-row,.card-count,.stack-card p,.text-link,.choice-card>b,.summary-stat span,.summary-meta,.fine-print,.card-visual>div,.card-role,.card-body>p,.tags span,.reward-line,.card-actions .button,.detail-close,.card-detail-visual>div,.card-detail-visual .detail-dots,.card-detail-section h3,.reward-pill .rp-cat,.meta-item span,.meta-item b,.perk-tag,.partner-tag,.detail-bonus .bonus-spend,.card-signup-btn,.card-remove-btn,.spread-card>div,.spread-card .spread-dots,.bottom-nav a,.chat-header small,.chat-msg-avatar{line-height:1.5}

@media (prefers-reduced-motion: reduce){main.page-exit,main.page-enter{opacity:1;transform:none;animation:none;transition:none}.toast-entering,.toast-exiting{transform:none}*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}}

/* Dark mode follows the OS unless an explicit light preference has been saved. */
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){--text:#f0f0f5;--ink:#f0f0f5;--panel:#1a1a2e;--line:#2d2d44;--muted:#8888a0;--purple:#7c73ff;--tone-1:linear-gradient(145deg,#857cff,#5548e8);--tone-2:linear-gradient(145deg,#20d5b2,#087e69);--tone-3:linear-gradient(145deg,#aaa5ca,#625e7d);--tone-4:linear-gradient(145deg,#ff718c,#c73555);--tone-5:linear-gradient(145deg,#ffb347,#c77816);--tone-6:linear-gradient(145deg,#4db5f9,#236ebf);color-scheme:dark}
  :root:not([data-theme="light"]) body{background:#111122}
}
:root[data-theme="dark"]{--text:#f0f0f5;--ink:#f0f0f5;--panel:#1a1a2e;--line:#2d2d44;--muted:#8888a0;--purple:#7c73ff;--tone-1:linear-gradient(145deg,#857cff,#5548e8);--tone-2:linear-gradient(145deg,#20d5b2,#087e69);--tone-3:linear-gradient(145deg,#aaa5ca,#625e7d);--tone-4:linear-gradient(145deg,#ff718c,#c73555);--tone-5:linear-gradient(145deg,#ffb347,#c77816);--tone-6:linear-gradient(145deg,#4db5f9,#236ebf);color-scheme:dark}
:root[data-theme="dark"] body{background:#111122}

@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]) .site-nav,:root:not([data-theme="light"]) .results-footer{background:#1a1a2eee}
  :root:not([data-theme="light"]) .bottom-nav{background:#1a1a2ef5}
  :root:not([data-theme="light"]) .avatar,:root:not([data-theme="light"]) .button-secondary,:root:not([data-theme="light"]) .eyebrow,:root:not([data-theme="light"]) .float-pill,:root:not([data-theme="light"]) .stack-card,:root:not([data-theme="light"]) .choice-card,:root:not([data-theme="light"]) .mini-choice,:root:not([data-theme="light"]) .line-choice,:root:not([data-theme="light"]) .result-card,:root:not([data-theme="light"]) .wallet-detail-panel,:root:not([data-theme="light"]) .perk-tag{background:var(--panel)}
  :root:not([data-theme="light"]) .match-summary,:root:not([data-theme="light"]) .meta-item,:root:not([data-theme="light"]) .reward-pill{background:#1f1f35}
  :root:not([data-theme="light"]) .card-count,:root:not([data-theme="light"]) .stack-icon,:root:not([data-theme="light"]) .choice-emoji,:root:not([data-theme="light"]) .detail-bonus,:root:not([data-theme="light"]) .partner-tag{background:#262642}
  :root:not([data-theme="light"]) .progress{background:#2d2d44}
  :root:not([data-theme="light"]) .choice-card:has(input:checked),:root:not([data-theme="light"]) .mini-choice:has(input:checked),:root:not([data-theme="light"]) .line-choice:has(input:checked){background:#252344}
  :root:not([data-theme="light"]) .card-back{background:linear-gradient(145deg,#9b94ff,#665bff);color:#17132f}
  :root:not([data-theme="light"]) .card-front,:root:not([data-theme="light"]) .tone-1{background:linear-gradient(145deg,#857cff,#5548e8)}
  :root:not([data-theme="light"]) .tone-2{background:linear-gradient(145deg,#20d5b2,#087e69)}
  :root:not([data-theme="light"]) .tone-3{background:linear-gradient(145deg,#aaa5ca,#625e7d)}
  :root:not([data-theme="light"]) .demo-card,:root:not([data-theme="light"]) .float-pill,:root:not([data-theme="light"]) .stack-card:hover{box-shadow:0 8px 24px rgba(0,0,0,.3)}
  :root:not([data-theme="light"]) .chat-panel{background:#17172a;box-shadow:0 12px 40px rgba(0,0,0,.3)}
  :root:not([data-theme="light"]) .chat-header,:root:not([data-theme="light"]) .chat-input-row{background:#1a1a2e}
  :root:not([data-theme="light"]) .chat-msg-bot .chat-msg-bubble{background:#25253d;color:var(--text)}
  :root:not([data-theme="light"]) .chat-msg-user .chat-msg-bubble{background:#665de8;color:#fff}
  :root:not([data-theme="light"]) .chat-msg-user .chat-msg-avatar{background:#302d58;color:#b9b4ff}
  :root:not([data-theme="light"]) .chat-input{background:#111122;color:var(--text)}
  :root:not([data-theme="light"]) .chat-input::placeholder{color:var(--muted)}
}

:root[data-theme="dark"] .site-nav,:root[data-theme="dark"] .results-footer{background:#1a1a2eee}:root[data-theme="dark"] .bottom-nav{background:#1a1a2ef5}
:root[data-theme="dark"] .avatar,:root[data-theme="dark"] .button-secondary,:root[data-theme="dark"] .eyebrow,:root[data-theme="dark"] .float-pill,:root[data-theme="dark"] .stack-card,:root[data-theme="dark"] .choice-card,:root[data-theme="dark"] .mini-choice,:root[data-theme="dark"] .line-choice,:root[data-theme="dark"] .result-card,:root[data-theme="dark"] .wallet-detail-panel,:root[data-theme="dark"] .perk-tag{background:var(--panel)}
:root[data-theme="dark"] .match-summary,:root[data-theme="dark"] .meta-item,:root[data-theme="dark"] .reward-pill{background:#1f1f35}
:root[data-theme="dark"] .card-count,:root[data-theme="dark"] .stack-icon,:root[data-theme="dark"] .choice-emoji,:root[data-theme="dark"] .detail-bonus,:root[data-theme="dark"] .partner-tag{background:#262642}
:root[data-theme="dark"] .progress{background:#2d2d44}:root[data-theme="dark"] .choice-card:has(input:checked),:root[data-theme="dark"] .mini-choice:has(input:checked),:root[data-theme="dark"] .line-choice:has(input:checked){background:#252344}
:root[data-theme="dark"] .card-back{background:linear-gradient(145deg,#9b94ff,#665bff);color:#17132f}:root[data-theme="dark"] .card-front,:root[data-theme="dark"] .tone-1{background:linear-gradient(145deg,#857cff,#5548e8)}:root[data-theme="dark"] .tone-2{background:linear-gradient(145deg,#20d5b2,#087e69)}:root[data-theme="dark"] .tone-3{background:linear-gradient(145deg,#aaa5ca,#625e7d)}
:root[data-theme="dark"] .demo-card,:root[data-theme="dark"] .float-pill,:root[data-theme="dark"] .stack-card:hover{box-shadow:0 8px 24px rgba(0,0,0,.3)}
:root[data-theme="dark"] .chat-panel{background:#17172a;box-shadow:0 12px 40px rgba(0,0,0,.3)}:root[data-theme="dark"] .chat-header,:root[data-theme="dark"] .chat-input-row{background:#1a1a2e}:root[data-theme="dark"] .chat-msg-bot .chat-msg-bubble{background:#25253d;color:var(--text)}:root[data-theme="dark"] .chat-msg-user .chat-msg-bubble{background:#665de8;color:#fff}:root[data-theme="dark"] .chat-msg-user .chat-msg-avatar{background:#302d58;color:#b9b4ff}:root[data-theme="dark"] .chat-input{background:#111122;color:var(--text)}:root[data-theme="dark"] .chat-input::placeholder{color:var(--muted)}

/* Card comparison */
.compare-page{padding:48px 0 80px}.compare-heading{margin-bottom:32px}.compare-heading h1{font-size:46px;margin:16px 0 8px}.compare-heading h1 em{color:var(--purple);font-style:normal}.compare-heading p,.compare-empty p{color:var(--muted)}
.compare-empty{text-align:center;border:1px solid var(--line);border-radius:16px;padding:72px 24px;background:#f9f9fb}.compare-empty h2{font-size:28px}.compare-empty p{margin:8px auto 24px;max-width:520px}
.compare-scroll{overflow-x:auto;border:1px solid var(--line);border-radius:16px;background:var(--panel);overscroll-behavior-inline:contain}.compare-table{width:100%;min-width:calc(190px + var(--card-count) * 230px);border-collapse:separate;border-spacing:0;table-layout:fixed}
.compare-table th,.compare-table td{padding:16px;border-bottom:1px solid var(--line);border-right:1px solid var(--line);text-align:left;vertical-align:middle}.compare-table tr>*:last-child{border-right:0}.compare-table tbody tr:last-child>*{border-bottom:0}.compare-table th:first-child{width:190px;color:var(--muted);font-size:13px;font-weight:600}.compare-table td{font-size:14px}
.compare-table thead th{position:sticky;top:0;z-index:5;background:var(--panel);padding:10px}.compare-table thead th:first-child{z-index:6}.compare-label{padding:16px;display:block}.compare-card-visual{height:142px;border-radius:12px;padding:16px;color:#fff;display:flex;flex-direction:column;justify-content:space-between;box-shadow:0 6px 18px #0002}.compare-card-visual>div{display:flex;align-items:center;justify-content:space-between;font-size:11px}.compare-card-visual>strong{font:700 17px var(--display)}.compare-card-visual>span:last-child{font-size:11px;opacity:.8}
.compare-table .compare-best-column{background:#f8f7ff}.compare-best-badge{position:absolute;top:4px;right:4px;z-index:1;padding:4px 10px;border-radius:99px;background:var(--purple);color:#fff;font-size:11px;line-height:1.2;white-space:nowrap;cursor:help;animation:compare-best-badge-in 300ms cubic-bezier(.16,1,.3,1) both}.compare-best-badge::after{content:attr(data-score-tooltip);position:absolute;top:calc(100% + 7px);right:0;padding:5px 8px;border-radius:6px;background:#25223a;color:#fff;font-size:11px;font-weight:500;white-space:nowrap;box-shadow:0 5px 14px #0003;opacity:0;transform:translateY(-3px);pointer-events:none;transition:opacity 140ms ease,transform 140ms ease}.compare-best-badge:hover::after,.compare-best-badge:focus-visible::after{opacity:1;transform:none}@keyframes compare-best-badge-in{from{opacity:0;transform:scale(.8)}to{opacity:1;transform:scale(1)}}
.compare-section-row th{background:#f9f9fb!important;padding:24px!important;color:var(--text)!important}.compare-section-row h2{font-size:20px}.compare-section-row p{margin:4px 0 0;color:var(--muted);font-size:12px;font-weight:400}.reward-compare-row td{position:relative}.compare-bar{height:7px;background:#eeeeF3;border-radius:99px;overflow:hidden;margin-bottom:8px}.compare-bar span{display:block;height:100%;background:#aaa8bb;border-radius:inherit}.reward-compare-row b{font:700 14px var(--display)}.reward-best{background:#f8f7ff}.reward-best .compare-bar span{background:var(--purple)}.reward-best b{color:var(--purple)}
.feature-row td{text-align:center}.feature-check{color:#c5c5ce;font-weight:700}.feature-check.included{display:inline-grid;place-items:center;width:27px;height:27px;border-radius:50%;background:#eeecff;color:var(--purple)}.muted-cell{color:var(--muted)}.compare-actions-row td{padding:20px 12px}.compare-actions-row .button{width:100%;padding:12px;font-size:13px}.add-compare-wallet.added,.compare-card.selected{background:var(--purple);color:#fff;border-color:var(--purple)}
.card-actions .compare-card{grid-column:1/-1}.compare-link[aria-disabled="true"]{opacity:.45;pointer-events:none}
@media(max-width:650px){.compare-page{padding-top:28px}.compare-heading h1{font-size:36px}.compare-scroll{margin-right:-14px;border-radius:14px 0 0 14px}.compare-table{min-width:calc(150px + var(--card-count) * 210px)}.compare-table th:first-child{width:150px}.results-footer{gap:8px}.results-footer p{display:none}.results-footer .button{padding:10px 12px;font-size:12px}}

@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .compare-table .compare-best-column{background:#1f1d38}}
:root[data-theme="dark"] .compare-table .compare-best-column{background:#1f1d38}

/* Explore and card-product surfaces */
:root[data-theme="dark"] .explore-page{background:#111122}:root[data-theme="dark"] .explore-toolbar{background:#111122ed}
:root[data-theme="dark"] .explore-search,:root[data-theme="dark"] .filter-chip,:root[data-theme="dark"] .explore-sort,:root[data-theme="dark"] .explore-card,:root[data-theme="dark"] .card-dialog,:root[data-theme="dark"] .similar-card,:root[data-theme="dark"] .product-tags span{background:var(--panel);color:var(--text)}
:root[data-theme="dark"] .filter-chip[aria-pressed="true"],:root[data-theme="dark"] .dialog-rewards span,:root[data-theme="dark"] .product-partners .product-tags span{background:#29264b;color:#b9b4ff;border-color:#484378}
:root[data-theme="dark"] .dialog-stats div,:root[data-theme="dark"] .product-detail-grid>div{background:#1f1f35;border-color:var(--line)}
:root[data-theme="dark"] .dialog-close{background:#2b2b43;color:var(--text)}:root[data-theme="dark"] .why-card>p{color:var(--text)}:root[data-theme="dark"] .product-reward-track{background:#2d2d44}
:root[data-theme="dark"] .tone-bg-1,:root[data-theme="dark"] .tone-bg-2,:root[data-theme="dark"] .tone-bg-3,:root[data-theme="dark"] .tone-bg-4,:root[data-theme="dark"] .tone-bg-5,:root[data-theme="dark"] .tone-bg-6{background:linear-gradient(135deg,#19182d,#111122 62%)}
:root[data-theme="dark"] .tone-1{background:var(--tone-1)}:root[data-theme="dark"] .tone-2{background:var(--tone-2)}:root[data-theme="dark"] .tone-3{background:var(--tone-3)}:root[data-theme="dark"] .tone-4{background:var(--tone-4)}:root[data-theme="dark"] .tone-5{background:var(--tone-5)}:root[data-theme="dark"] .tone-6{background:var(--tone-6)}
:root[data-theme="dark"] .result-card:hover,:root[data-theme="dark"] .card-visual,:root[data-theme="dark"] .card-visual:hover,:root[data-theme="dark"] .spread-card,:root[data-theme="dark"] .explore-card:hover,:root[data-theme="dark"] .explore-card:focus-visible,:root[data-theme="dark"] .explore-card-visual,:root[data-theme="dark"] .card-dialog,:root[data-theme="dark"] .card-product-visual,:root[data-theme="dark"] .product-bonus,:root[data-theme="dark"] .similar-card:hover{box-shadow:0 12px 32px rgba(0,0,0,.3)}
